{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "npm:*": ["node_modules/*"]
    }
  },
  "include": [
    "deno.d.ts",
    "**/*.ts"
  ]
}
