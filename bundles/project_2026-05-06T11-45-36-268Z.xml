    content: &apos;&apos;;
    position: absolute;
    inset: 0;
    background:
        radial-gradient(ellipse 60% 60% at 20% 80%, rgba(0, 123, 255, 0.15) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 80% 10%, rgba(13, 71, 161, 0.2) 0%, transparent 60%);
}

.heroContent {
    position: relative;
    max-width: 760px;
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 123, 255, 0.15);
    border: 1px solid rgba(0, 123, 255, 0.3);
    color: var(--sky-blue, #90CAF9);
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-bottom: 2.5rem;
}

.heroTitle {
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 1.75rem;
}

.heroHighlight {
    background: linear-gradient(135deg, var(--sky-blue, #90CAF9), var(--primary-blue, #007BFF));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.heroDesc {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.75;
    max-width: 560px;
    margin-bottom: 3.5rem;
}

/* Platform Pills */
.platforms {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.platformPill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
