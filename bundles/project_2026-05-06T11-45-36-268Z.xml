    <file path="app\(auth)\signup\signup.module.css" type="code">
      <content>/* ============================
   SIGNUP PAGE — Centered Card
   Full-screen, no scroll, form in center
   ============================ */

.page {
    width: 100vw;
    height: 100vh; /* Fixed height */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    position: relative;
    padding: 0; /* No padding for full fit */
    font-family: var(--font-inter), -apple-system, BlinkMacSystemFont, &apos;Segoe UI&apos;, sans-serif;
    overflow: hidden; /* Prevent page scrolling */
}

.page::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
}

/* Background decorations */
.bgGlow1 {
    position: absolute;
    top: -15%;
    left: -8%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 123, 255, 0.08) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
    animation: glowPulse 20s ease-in-out infinite alternate;
}

.bgGlow2 {
    position: absolute;
    bottom: -12%;
    right: -8%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(0, 123, 255, 0.06) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
    animation: glowPulse 16s ease-in-out infinite alternate-reverse;
}

@keyframes glowPulse {
    0% {
        transform: scale(1);
        opacity: 0.7;
    }

    100% {
        transform: scale(1.15);
        opacity: 1;
    }
}

.gridOverlay {
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(0, 0, 0, 0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 0, 0, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
}

/* Card */
.card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 380px; /* Even narrower */
    max-height: 95vh; /* Maximize fit */
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    padding: 1.5rem 1.75rem; /* Tighter padding */
    box-shadow:
        0 4px 6px -1px rgba(0, 0, 0, 0.03),
        0 10px 30px -5px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    gap: 0.75rem; /* Tighter gaps */
    animation: cardEnter 0.5s ease-out;

    /* Hide scrollbars but allow scrolling if absolutely needed */
    scrollbar-width: none;
    -ms-overflow-style: none;
    overflow-y: auto;
    overflow-x: hidden;
}

.card::-webkit-scrollbar {
    display: none;
}

@keyframes cardEnter {
    from {
        opacity: 0;
        transform: translateY(16px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* Logo */
.logoWrap {
    display: flex;
    justify-content: center;
    text-decoration: none;
}

.logoImg {
    filter: none;
    opacity: 1;
}

/* Progress stepper */

.progressSteps {
    display: flex;
    align-items: center;
}

.progressStep {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: opacity 0.3s ease;
}

.progressStep:not(.progressActive) {
    opacity: 0.3;
}

.progressDot {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #f1f5f9;
    border: 2px solid #e2e8f0;
    color: #94a3b8;
    font-size: 0.68rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.progressStep.progressActive .progressDot {
    background: var(--primary-blue);
    border-color: var(--primary-blue);
    color: white;
    box-shadow: 0 2px 6px rgba(0, 123, 255, 0.3);
}

.progressLabel {
    font-size: 0.72rem;
    font-weight: 600;
    color: #94a3b8;
}

.progressStep.progressActive .progressLabel {
    color: #374151;
}

.progressLine {
    flex: 1;
    height: 2px;
    background: #e5e7eb;
    margin: 0 0.6rem;
    transition: background 0.3s ease;
    border-radius: 1px;
}

.progressLine.progressLineActive {
    background: var(--primary-blue);
}

/* Header */
.header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
}

.subtitle {
    font-size: 0.8rem;
    color: #94a3b8;
}

.switchLink {
    color: var(--primary-blue);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s;
}

.switchLink:hover {
    color: #0056d6;
}

/* Step content */
.stepContent {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.stepLabel {
    font-size: 0.72rem;
    font-weight: 600;
    color: #94a3b8;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

/* Role cards */
.roleCards {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.roleCard {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    background: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 11px;
    cursor: pointer;
    transition: all 0.25s ease;
    text-align: left;
    width: 100%;
    font-family: inherit;
}

.roleCard:hover {
    border-color: #66b3ff;
    background: #f8fafc;
}

.roleCard.roleCardActive {
    border-color: var(--primary-blue);
    background: #e6f2ff;
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.08);
}

.roleIconWrap {
    width: 40px;
    height: 40px;
    background: #f1f5f9;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    flex-shrink: 0;
    transition: all 0.2s ease;
}

.roleCard.roleCardActive .roleIconWrap {
    background: #cce4ff;
    color: var(--primary-blue);
}

.roleContent {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
}

.roleTitle {
    font-size: 0.85rem;
    font-weight: 700;
    color: #0f172a;
}

.roleDesc {
    font-size: 0.72rem;
    color: #94a3b8;
}

.roleCheck {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--primary-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.2s ease;
}

.roleCard.roleCardActive .roleCheck {
    opacity: 1;
    transform: scale(1);
}

/* Divider */
.divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.dividerLine {
    flex: 1;
    height: 1px;
    background: #e5e7eb;
}

.dividerText {
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 500;
    white-space: nowrap;
}

/* Custom Scrollbar for inner containers */
.card::-webkit-scrollbar,
.innerScroll::-webkit-scrollbar {
    width: 6px;
}

.card::-webkit-scrollbar-track,
.innerScroll::-webkit-scrollbar-track {
    background: transparent;
}

.card::-webkit-scrollbar-thumb,
.innerScroll::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 10px;
}

.card::-webkit-scrollbar-thumb:hover,
.innerScroll::-webkit-scrollbar-thumb:hover {
    background: #cbd5e1;
}

/* Ensure RoleSelection fits on screen */
@media (min-height: 800px) {
    .page {
        justify-content: center;
    }
}

@media (max-height: 800px) {
    .page {
        padding: 1rem 0;
    }
}

/* Social */
.socialRow {
    display: flex;
    gap: 0.6rem;
}

.socialBtn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.55rem 0.75rem;
    background: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 9px;
    color: #374151;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
}

.socialBtn:hover {
    background: #f9fafb;
    border-color: #d1d5db;
}

/* Next button */
.nextBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    padding: 0.7rem 1.5rem;
    background: var(--primary-blue);
    color: white;
    border: none;
    border-radius: 9px;
    font-size: 0.88rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(0, 123, 255, 0.3);
}

.nextBtn:hover:not(:disabled) {
    background: #0056d6;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0, 123, 255, 0.4);
}

.nextBtn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    box-shadow: none;
}

/* Form (step 2) */
.form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
}

.nameRow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
}

.fieldGroup {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
}

.label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #374151;
}

.inputWrap {
    position: relative;
    display: flex;
    align-items: center;
}

.inputIcon {
    position: absolute;
    left: 0.75rem;
    color: #c0c7d0;
    pointer-events: none;
    z-index: 1;
    transition: color 0.2s ease;
}

.inputWrap:focus-within .inputIcon {
    color: var(--primary-blue);
}

.input {
    width: 100%;
    padding: 0.62rem 0.85rem;
    background: #f9fafb;
    border: 1.5px solid #e5e7eb;
    border-radius: 9px;
    color: #0f172a;
    font-size: 0.84rem;
    font-family: inherit;
    outline: none;
    transition: all 0.2s ease;
}

.inputWithIcon {
    padding-left: 2.4rem;
}

.input::placeholder {
    color: #b0b8c4;
}

.input:focus {
    background: #ffffff;
    border-color: var(--primary-blue);
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.08);
}

.input:hover:not(:focus) {
    border-color: #d1d5db;
}

.eyeBtn {
    position: absolute;
    right: 0.7rem;
    background: none;
    border: none;
    color: #b0b8c4;
    cursor: pointer;
    padding: 2px;
    display: flex;
    align-items: center;
    transition: color 0.2s;
}

.eyeBtn:hover {
    color: #64748b;
}

/* Strength bar */
.strengthBar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.2rem;
}

.strengthSegments {
    display: flex;
    gap: 3px;
    flex: 1;
}

.strengthSegment {
    height: 3px;
    flex: 1;
    border-radius: 2px;
    transition: background 0.3s ease;
}

.strengthLabel {
    font-size: 0.68rem;
    font-weight: 700;
    min-width: 32px;
    text-align: right;
}

/* Checkbox */
.checkboxLabel {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    cursor: pointer;
    user-select: none;
}

.checkbox {
    display: none;
}

.checkboxCustom {
    width: 16px;
    height: 16px;
    border: 1.5px solid #d1d5db;
    border-radius: 4px;
    background: #ffffff;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    margin-top: 1px;
}

.checkboxCustom svg {
    width: 9px;
    height: 9px;
    opacity: 0;
    transition: opacity 0.15s ease;
}

.checkbox:checked+.checkboxCustom {
    background: var(--primary-blue);
    border-color: var(--primary-blue);
}

.checkbox:checked+.checkboxCustom svg {
    opacity: 1;
}

.checkboxText {
    font-size: 0.75rem;
    color: #64748b;
    line-height: 1.45;
}

.inlineLink {
    color: var(--primary-blue);
    text-decoration: none;
    font-weight: 600;
}

.inlineLink:hover {
    text-decoration: underline;
}

/* Actions */
.formActions {
    display: flex;
    gap: 0.55rem;
    align-items: center;
}

.backBtn {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.65rem 0.95rem;
    background: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 9px;
    color: #64748b;
    font-size: 0.82rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
}

.backBtn:hover {
    background: #f9fafb;
    border-color: #d1d5db;
    color: #374151;
}

.submitBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    flex: 1;
    padding: 0.7rem 1rem;
    background: var(--primary-blue);
    color: white;
    border: none;
    border-radius: 9px;
    font-size: 0.88rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(0, 123, 255, 0.3);
}

.submitBtn:hover:not(:disabled) {
    background: #0056d6;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0, 123, 255, 0.4);
}

.submitBtn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    box-shadow: none;
}

.spinnerWrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

/* Terms */
.terms {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.66rem;
    color: #b0b8c4;
    text-align: center;
    white-space: nowrap;
    z-index: 1;
}

.termsLink {
    color: #94a3b8;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
}

.termsLink:hover {
    color: var(--primary-blue);
}

/* Both candidate and recruiter use the same brand blue theme */

/* ============================
   RESPONSIVE
   ============================ */
@media (max-width: 480px) {
    .card {
        max-width: 100%;
        margin: 0 0.75rem;
        padding: 1.5rem 1.25rem;
        border-radius: 16px;
    }

    .title {
        font-size: 1.25rem;
    }

    .nameRow {
        grid-template-columns: 1fr;
    }

    .socialRow {
        flex-direction: column;
        gap: 0.4rem;
    }

    .formActions {
        flex-direction: column-reverse;
    }

    .backBtn {
        width: 100%;
        justify-content: center;
    }
}

@media (max-height: 750px) {
    .card {
        gap: 0.85rem;
        padding: 1.5rem 1.75rem;
    }

    .form {
        gap: 0.65rem;
    }

    .stepContent {
        gap: 0.75rem;
    }

    .input {
        padding-top: 0.55rem;
        padding-bottom: 0.55rem;
        font-size: 0.82rem;
    }

    .roleCard {
        padding: 0.7rem 0.85rem;
    }

    .nextBtn,
    .submitBtn {
        padding: 0.6rem 1rem;
