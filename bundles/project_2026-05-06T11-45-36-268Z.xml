.saveBtn {
    padding: 0.5rem 0.65rem;
    background: #f5f7fa;
    border: 1px solid #eef0f2;
    border-radius: 8px;
    cursor: pointer;
    color: #64748b;
    display: flex;
    align-items: center;
    transition: all 0.15s ease;
}

.saveBtn:hover {
    background: #eef0f2;
}

.matchBox {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
