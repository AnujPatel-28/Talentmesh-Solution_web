              /&gt;
              &lt;AdminInput
                label=&quot;Exp Max (Years)&quot;
                type=&quot;number&quot;
                value={form.experience_max}
                onChange={e =&gt; handleChange(&apos;experience_max&apos;, e.target.value)}
                placeholder=&quot;5&quot;
              /&gt;
              &lt;AdminInput
                label=&quot;Department&quot;
                value={form.department}
                onChange={e =&gt; handleChange(&apos;department&apos;, e.target.value)}
