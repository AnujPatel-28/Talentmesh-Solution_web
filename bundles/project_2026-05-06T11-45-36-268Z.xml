}

.matchBoxTitle {
    font-size: 0.78rem;
    font-weight: 700;
    color: #166534;
}

.matchPoints {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
}

.matchPoint {
    font-size: 0.68rem;
    color: #15803d;
    display: flex;
    align-items: flex-start;
    gap: 0.25rem;
}

.matchWarn {
    color: #d97706;
}

.jobSection {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
}

.jobSectionTitle {
    font-size: 0.88rem;
    font-weight: 700;
    color: #0f172a;
}

.jobSectionText {
    font-size: 0.78rem;
    color: #475569;
    line-height: 1.55;
}

.jobSectionList {
    list-style: disc;
    padding-left: 1.2rem;
}

.jobSectionList li {
    font-size: 0.78rem;
    color: #475569;
