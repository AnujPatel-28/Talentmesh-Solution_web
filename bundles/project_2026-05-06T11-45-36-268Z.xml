                    router.push(`/dashboard/recruiter/${updatedUser?.public_id || user?.public_id || user?.role_id || &apos;recruiter&apos;}`);
                }}&gt;Skip for now&lt;/button&gt;
            &lt;/p&gt;
        &lt;/div&gt;
    );
}
