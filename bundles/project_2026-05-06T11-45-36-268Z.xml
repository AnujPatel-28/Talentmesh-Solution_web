    <file path="app\career-advice\career-advice.module.css" type="code">
      <content>/* ─── Page ───────────────────────────────────────────────────────────────────── */
.page {
    padding-top: 68px;
    min-height: 100vh;
    background: var(--light-ice-blue, #F0F7FF);
}

/* ─── Hero ───────────────────────────────────────────────────────────────────── */
.hero {
    background: linear-gradient(135deg, var(--alice-blue, #E3F2FD) 0%, var(--light-ice-blue, #F0F7FF) 100%);
    padding: clamp(48px, 10vh, 60px) 16px clamp(40px, 8vh, 52px);
    text-align: center;
    border-bottom: 1px solid var(--sky-blue, #90CAF9);
}

.heroInner {
    max-width: 680px;
    margin: 0 auto;
}

.heroTitle {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 800;
    color: var(--cobalt-blue, #0D47A1);
    margin: 0 0 16px;
    line-height: 1.15;
    letter-spacing: -0.02em;
}

.heroSub {
    font-size: 1.08rem;
    color: var(--medium-grey, #475569);
    margin: 0 auto 24px;
    line-height: 1.65;
}

.trustNote {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--alice-blue);
    border-left: 4px solid var(--primary-blue, #007BFF);
    color: var(--ocean-deep, #1565C0);
    font-size: 0.9rem;
    padding: 10px 18px;
    border-radius: 0 8px 8px 0;
}

/* ─── Form Section ───────────────────────────────────────────────────────────── */
.formSection {
    padding: clamp(32px, 6vh, 48px) 16px;
}

.formLayout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 32px;
    align-items: flex-start;
}

/* Form card */
.formCard {
    background: white;
    border-radius: 24px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.10);
    padding: clamp(24px, 5vw, 40px);
}

.formTitle {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--cobalt-blue);
    margin: 0 0 4px;
}

.formNote {
    font-size: 0.82rem;
    color: var(--medium-grey);
    margin: 0 0 28px;
}

.form {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.fieldRow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--cobalt-blue, #0D47A1);
}

.optional {
    font-style: italic;
    font-weight: 400;
    color: var(--medium-grey);
    font-size: 0.8rem;
}

.selectAll {
    font-weight: 400;
    color: var(--medium-grey);
    font-size: 0.8rem;
}

.input,
.select,
.textarea {
    border: 1px solid var(--sky-blue, #90CAF9);
    border-radius: 8px;
    padding: 11px 14px;
    font-size: 0.9rem;
    font-family: inherit;
    background: white;
    color: var(--deep-navy, #0d2137);
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
    appearance: none;
}

.input::placeholder,
.textarea::placeholder {
    color: rgba(71, 85, 105, 0.55);
}

.input:focus,
.select:focus,
.textarea:focus {
    border-color: var(--primary-blue, #007BFF);
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.12);
}

.select {
    cursor: pointer;
}

.textarea {
    resize: vertical;
    min-height: 100px;
}

/* Multi-select chips */
.chipGroup {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
}

.helpChip {
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--sky-blue, #90CAF9);
    background: white;
    color: var(--ocean-deep, #1565C0);
    font-size: 0.83rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.18s ease;
    font-family: inherit;
}

.helpChip:hover {
    border-color: var(--dodger-blue);
    color: var(--dodger-blue);
}

.helpChipActive {
    background: var(--dodger-blue, #2196F3) !important;
    color: white !important;
    border-color: var(--dodger-blue) !important;
}

/* Radio group */
.radioGroup {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 4px;
}

.radioLabel {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.88rem;
    color: var(--medium-grey);
    cursor: pointer;
}

.radioLabel input {
    accent-color: var(--primary-blue);
    cursor: pointer;
}

/* Submit */
.submitBtn {
    width: 100%;
    height: 52px;
    background: linear-gradient(135deg, var(--primary-blue, #007BFF) 0%, var(--dodger-blue, #2196F3) 100%);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 4px;
    font-family: inherit;
}

.submitBtn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 123, 255, 0.45);
}

/* Success state */
.successState {
    text-align: center;
    padding: 48px 24px;
}

.successIco {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #DCFCE7;
    color: #16A34A;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
}

.successTitle {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--cobalt-blue);
    margin: 0 0 10px;
}

.successDesc {
    font-size: 1rem;
    color: var(--medium-grey);
    margin: 0 0 20px;
    line-height: 1.6;
}

.successBadge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--alice-blue);
    color: var(--ocean-deep);
    font-weight: 600;
    font-size: 0.88rem;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--sky-blue);
}

/* ─── Aside ──────────────────────────────────────────────────────────────────── */
.aside {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.asideCard {
    background: white;
    border-radius: 16px;
    padding: 24px;
    border: 1px solid var(--sky-blue);
}

.asideTitle {
    font-size: 1rem;
    font-weight: 700;
    color: var(--cobalt-blue);
    margin: 0 0 16px;
}

.asideItem {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--medium-grey);
    margin-bottom: 10px;
}

.asideCheck {
    color: var(--primary-blue);
    flex-shrink: 0;
    margin-top: 1px;
}

.asideStat {
    background: white;
    border-radius: 16px;
    padding: 20px;
    border: 1px solid var(--sky-blue);
    display: flex;
    justify-content: space-between;
    gap: 8px;
}

.asideStatItem {
    text-align: center;
}

.asideStatVal {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--cobalt-blue);
}

.asideStatLabel {
    font-size: 0.72rem;
    color: var(--medium-grey);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* ─── How It Works ───────────────────────────────────────────────────────────── */
.howSection {
    background: var(--light-ice-blue, #F0F7FF);
    padding: clamp(48px, 8vh, 64px) 16px;
}

.sectionTitle {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--cobalt-blue);
    text-align: center;
    margin: 0 0 40px;
}

.stepsRow {
    display: flex;
    align-items: center;
    gap: 0;
    justify-content: center;
}

.stepCard {
    text-align: center;
    max-width: 200px;
    padding: 0 8px;
}

.stepCircle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--dodger-blue, #2196F3);
    color: white;
    font-size: 1.15rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 14px;
    box-shadow: 0 4px 16px rgba(33, 150, 243, 0.35);
}

.stepConnector {
    flex: 1;
    height: 2px;
    border-top: 2px dashed var(--sky-blue, #90CAF9);
    max-width: 60px;
    flex-shrink: 0;
}

.stepTitle {
    font-size: 0.93rem;
    font-weight: 700;
    color: var(--cobalt-blue);
    margin: 0 0 6px;
}

.stepDesc {
    font-size: 0.8rem;
    color: var(--medium-grey);
    line-height: 1.5;
    margin: 0;
}

/* ─── Trust Section ──────────────────────────────────────────────────────────── */
.trustSection {
    background: white;
    padding: clamp(48px, 8vh, 64px) 16px 0;
}

.testiGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 48px;
}

.testiCard {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(12px);
    border-radius: 16px;
    border: 1px solid rgba(144, 202, 249, 0.5);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.stars {
    display: flex;
    gap: 3px;
    color: #F59E0B;
}

.quote {
    font-size: 0.93rem;
    color: var(--medium-grey);
    line-height: 1.65;
    margin: 0;
    font-style: italic;
}

.author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
}

.authorAvatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-blue), var(--dodger-blue));
    color: white;
    font-weight: 700;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.authorName {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--cobalt-blue);
}

.authorRole {
    font-size: 0.78rem;
    color: var(--medium-grey);
}

/* Stats bar */
.statsBar {
    background: var(--ocean-deep, #1565C0);
    padding: clamp(32px, 6vh, 48px) clamp(24px, 5vw, 48px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
}

.statsDivider {
    width: 1px;
    height: 48px;
    background: rgba(144, 202, 249, 0.35);
    margin: 0 48px;
}

.statItem {
    text-align: center;
}

.statVal {
    font-size: 2.25rem;
    font-weight: 800;
    color: white;
    line-height: 1;
}

.statLabel {
    font-size: 0.85rem;
    color: var(--sky-blue, #90CAF9);
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
}

/* ─── Responsive ─────────────────────────────────────────────────────────────── */
@media (max-width: 1024px) {
    .formLayout {
        grid-template-columns: 1fr;
    }

    .aside {
        position: static;
        flex-direction: row;
    }

    .asideCard {
        flex: 1;
    }

    .asideStat {
        flex: 0 0 auto;
    }
}

@media (max-width: 768px) {
    .stepsRow {
        flex-direction: column;
        gap: 24px;
    }

    .stepConnector {
        transform: rotate(90deg);
        max-width: 32px;
    }

    .testiGrid {
        grid-template-columns: 1fr;
    }

    .aside {
        flex-direction: column;
    }

    .statsBar {
        flex-direction: column;
        gap: 28px;
    }

    .statsDivider {
        width: 100%;
        height: 1px;
        margin: 0;
    }
}

@media (max-width: 640px) {
    .formCard {
        padding: 24px 20px;
    }

    .fieldRow {
        grid-template-columns: 1fr;
    }
}</content>
