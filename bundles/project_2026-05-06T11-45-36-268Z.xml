    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.pipelineTitle {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
}

.pipelineSub {
    font-size: 0.78rem;
    color: #94a3b8;
}

.pipelineActions {
    display: flex;
    gap: 0.4rem;
}

.pipelineViewBtn {
