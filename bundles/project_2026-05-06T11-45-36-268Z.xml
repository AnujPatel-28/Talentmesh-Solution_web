    <file path="components\notifications\notification-center.module.css" type="code">
      <content>.container {
    display: flex;
    height: calc(100vh - 80px); /* Fill available space minus top header */
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #e8ecf0;
    overflow: hidden;
    font-family: var(--font-inter), sans-serif;
    margin: 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}

/* Sidebar */
.sidebar {
    width: 240px;
    background: #f8fafc;
    border-right: 1px solid #e8ecf0;
    display: flex;
    flex-direction: column;
    padding: 1rem 0;
    flex-shrink: 0;
}

.sidebarHeader {
    padding: 0 1rem 1rem 1rem;
    font-weight: 600;
    font-size: 1.1rem;
    color: #0f172a;
}

.navItem {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    cursor: pointer;
    color: #475569;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s ease;
}

.navItem:hover {
    background: #f1f5f9;
    color: #1e293b;
}

.navItemActive {
    background: #e0f2fe;
    color: var(--primary-blue);
    border-right: 3px solid var(--primary-blue);
    font-weight: 600;
}

.navLabel {
    display: flex;
    align-items: center;
    gap: 12px;
}

.badge {
    background: #ef4444;
    color: white;
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 600;
}

/* Message List */
.listContainer {
    width: 350px;
    border-right: 1px solid #e8ecf0;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    flex-shrink: 0;
}

.listHeader {
    padding: 1rem;
    border-bottom: 1px solid #e8ecf0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
}

.listTitle {
    font-weight: 600;
    color: #0f172a;
}

.scrollArea {
    flex: 1;
    overflow-y: auto;
}

.messageItem {
    padding: 1rem;
    border-bottom: 1px solid #f0f2f5;
    cursor: pointer;
    transition: background 0.2s ease;
    display: flex;
    gap: 12px;
}

.messageItem:hover {
    background: #f8fafc;
    box-shadow: inset 3px 0 0 #cbd5e1;
}

.messageItemActive {
    background: #f1f5f9;
    box-shadow: inset 3px 0 0 var(--primary-blue);
}

.messageItemUnread {
    background: #ffffff;
}

.messageItemUnread .sender {
    font-weight: 700;
    color: #0f172a;
}

.messageItemUnread .subject {
    font-weight: 600;
    color: #1e293b;
}

.avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    color: #475569;
    flex-shrink: 0;
}

.messageContent {
    flex: 1;
    min-width: 0; /* Important for truncation */
}

.messageTop {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
}

.sender {
    font-size: 0.9rem;
    color: #334155;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.time {
    font-size: 0.75rem;
    color: #64748b;
    flex-shrink: 0;
}

.subject {
    font-size: 0.85rem;
    color: #475569;
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.snippet {
    font-size: 0.8rem;
    color: #94a3b8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Detail Pane */
.detailContainer {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    min-width: 0; /* Ensures child elements can truncate */
}

.detailHeader {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e8ecf0;
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #ffffff;
}

.backBtn {
    display: none; /* Only show on mobile */
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    transition: background 0.2s;
}

.backBtn:hover {
    background: #f1f5f9;
    color: #0f172a;
}

.detailActions {
    margin-left: auto;
    display: flex;
    gap: 0.5rem;
}

.actionBtn {
    background: none;
    border: 1px solid #e2e8f0;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 6px;
}

.actionBtn:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
}

.detailScroll {
    flex: 1;
    overflow-y: auto;
    padding: 2rem;
}

.detailSubject {
    font-size: 1.5rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 1.5rem;
}

.detailMeta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
}

.detailSenderInfo {
    flex: 1;
}

.detailSenderName {
    font-weight: 600;
    color: #0f172a;
    font-size: 0.95rem;
}

.detailSenderEmail {
    color: #64748b;
    font-size: 0.85rem;
}

.detailTime {
    color: #64748b;
    font-size: 0.85rem;
}

.detailBody {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #334155;
}

.emptyState {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    background: #f8fafc;
}

.emptyIcon {
    margin-bottom: 1rem;
    color: #cbd5e1;
}

.emptyText {
    font-size: 1.1rem;
    font-weight: 500;
}

/* Mobile Responsiveness */
@media (max-width: 992px) {
    .container {
        margin: 0;
        height: 100%;
        border-radius: 0;
        border: none;
    }

    .sidebar {
        width: 60px;
        padding: 1rem 0;
        align-items: center;
    }

    .sidebarHeader {
        display: none;
    }

    .navLabel span {
        display: none; /* Hide text, keep icon */
    }

    .navItem {
        justify-content: center;
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        border-radius: 8px;
    }

    .navItemActive {
        border-right: none;
        background: #e0f2fe;
    }
    
    .badge {
        position: absolute;
        top: 2px;
        right: 2px;
        padding: 2px 5px;
        font-size: 0.6rem;
    }
}

@media (max-width: 768px) {
    /* Stack mode for mobile - show only one pane at a time */
    .sidebar {
        display: none; /* Could implement a hamburger for this, but let&apos;s hide for simplicity */
    }

    .listContainer {
        width: 100%;
        border-right: none;
    }

    /* If a message is selected, hide the list and show the detail pane */
    .container.viewingDetail .listContainer {
        display: none;
    }

    .container:not(.viewingDetail) .detailContainer {
        display: none;
    }

    .backBtn {
        display: block;
    }

    .detailScroll {
        padding: 1rem;
    }

    .detailSubject {
        font-size: 1.25rem;
    }
}
</content>
