    <file path="app\job-seekers\job-seekers.module.css" type="code">
      <content>/* ── Job Seekers Page ── */
.page {
    background: #fff;
}

/* Hero */
.hero {
    background: var(--deep-navy);
    padding: clamp(6rem, 15vh, 10rem) 16px clamp(4rem, 10vh, 8rem);
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: &apos;&apos;;
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 60% 0%, rgba(0, 123, 255, 0.18) 0%, transparent 70%);
}

.heroContent {
    position: relative;
    max-width: 760px;
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 123, 255, 0.15);
    border: 1px solid rgba(0, 123, 255, 0.3);
    color: #60a5fa;
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-bottom: 2.5rem;
}

.heroTitle {
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 2rem;
}

.heroHighlight {
    background: linear-gradient(135deg, #007BFF, #60a5fa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.heroDesc {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.75;
    max-width: 580px;
    margin-bottom: 3.5rem;
}

.heroCtas {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
}

.primaryCta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #007BFF;
    color: #fff;
    padding: 1rem 2.5rem;
    border-radius: 14px;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
}

.primaryCta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0, 123, 255, 0.4);
}

.secondaryCta {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 1rem 2.5rem;
    border-radius: 14px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: background 0.2s;
}

.secondaryCta:hover {
    background: rgba(255, 255, 255, 0.14);
}

/* Stats Strip */
.statsStrip {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}

.statsGrid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: clamp(2rem, 5vh, 4rem) 16px;
    gap: 2rem;
}

.statItem {
    text-align: center;
}

.statVal {
    display: block;
    font-size: 2.75rem;
    font-weight: 900;
    color: var(--primary-blue);
    letter-spacing: -0.04em;
}

.statLabel {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--medium-grey);
    margin-top: 0.5rem;
}

/* Section shared */
.sectionHeader {
    margin-bottom: 5rem;
}

.sectionTag {
    display: inline-block;
    color: var(--primary-blue);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
}

.sectionTitle {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 900;
    color: var(--deep-navy);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1rem;
}

.sectionDesc {
    font-size: 1.125rem;
    color: var(--medium-grey);
    line-height: 1.7;
    max-width: 560px;
}

/* How It Works */
.howSection {
    padding: clamp(4rem, 10vh, 8rem) 16px;
}

.stepsGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
}

.stepCard {
    background: #f8fafc;
    border-radius: var(--radius-lg);
    padding: 3rem 2.5rem;
    border: 1px solid #e2e8f0;
    position: relative;
    overflow: hidden;
    transition: transform 0.25s, box-shadow 0.25s;
}

.stepCard:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
}

.stepNum {
    font-size: 3.5rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
    margin-bottom: 1.5rem;
}

.stepTitle {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--deep-navy);
    margin-bottom: 1rem;
}

.stepDesc {
    font-size: 0.95rem;
    color: var(--medium-grey);
    line-height: 1.7;
}

.stepLine {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 4px;
}

/* Benefits */
.benefitsSection {
    padding: clamp(4rem, 10vh, 8rem) 16px;
    background: var(--light-ice-blue);
}

.benefitsGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
}

.benefitCard {
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    border: 1px solid rgba(0, 123, 255, 0.1);
    transition: transform 0.25s, box-shadow 0.25s;
}

.benefitCard:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0, 123, 255, 0.1);
}

.benefitIcon {
    font-size: 2.5rem;
    margin-bottom: 1.25rem;
}

.benefitTitle {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--deep-navy);
    margin-bottom: 0.75rem;
}

.benefitDesc {
    font-size: 0.9rem;
    color: var(--medium-grey);
    line-height: 1.7;
}

/* Testimonials */
.testimonialsSection {
    padding: clamp(4rem, 10vh, 8rem) 16px;
    background: var(--deep-navy);
}

.testimonialsSection .sectionTag {
    color: rgba(0, 123, 255, 0.8);
}

.testimonialsGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 1rem;
}

.testimonialCard {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.outcomeBadge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 50px;
    width: fit-content;
}

.testimonialQuote {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.7;
    font-style: italic;
    flex: 1;
}

.testimonialMeta {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.9rem;
    color: #fff;
    flex-shrink: 0;
}

.testimonialName {
    font-weight: 800;
    color: #fff;
    font-size: 0.95rem;
}

.testimonialRole {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
}

/* CTA */
.ctaSection {
    padding: clamp(4rem, 10vh, 8rem) 16px;
}

.ctaCard {
    background: var(--gradient-premium);
    border-radius: clamp(24px, 5vw, 40px);
    padding: clamp(4rem, 12vh, 8rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    color: #fff;
}

.ctaTitle {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 900;
    margin-bottom: 1.5rem;
    letter-spacing: -0.04em;
}

.ctaDesc {
    font-size: 1.2rem;
    opacity: 0.8;
    margin-bottom: 3.5rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
}

.ctaBtns {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    flex-wrap: wrap;
}

.ctaPrimary {
    background: #fff;
    color: var(--primary-blue);
    padding: 1.1rem 3rem;
    border-radius: 14px;
    font-weight: 900;
    font-size: 1rem;
    text-decoration: none;
    transition: transform 0.2s;
}

.ctaPrimary:hover {
    transform: translateY(-2px);
}

.ctaSecondary {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 1.1rem 3rem;
    border-radius: 14px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    backdrop-filter: blur(10px);
    transition: background 0.2s;
}

.ctaSecondary:hover {
    background: rgba(255, 255, 255, 0.18);
}

/* Responsive */
@media (max-width: 1024px) {
    .benefitsGrid {
        grid-template-columns: repeat(2, 1fr);
    }

    .testimonialsGrid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .hero {
        padding: 7rem 0 5rem;
    }

    .statsGrid {
        grid-template-columns: repeat(2, 1fr);
    }

    .stepsGrid {
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    .benefitsGrid {
        grid-template-columns: 1fr;
    }

    .testimonialsGrid {
        grid-template-columns: 1fr;
    }

    .ctaCard {
        padding: 5rem 2rem;
        border-radius: 24px;
    }
}</content>
