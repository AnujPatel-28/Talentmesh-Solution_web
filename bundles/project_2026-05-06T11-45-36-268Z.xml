               &lt;Typography variant=&quot;caption&quot; sx={{ color: &apos;rgba(255,255,255,0.4)&apos;, fontStyle: &apos;italic&apos; }}&gt;Candidate is typing...&lt;/Typography&gt;
            &lt;/Box&gt;
          &lt;/Box&gt;
        &lt;/Box&gt;
      &lt;/Box&gt;
    &lt;/Box&gt;
  );
};
