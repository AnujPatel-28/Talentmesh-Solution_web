    <file path="components\sections\Features.module.css" type="code">
      <content>.section {
    padding: 6rem 2rem;
    background: transparent;
    position: relative;
    z-index: 1;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
}

.header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 4rem;
}

.title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--deep-navy) 0%, #334155 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.subtitle {
    font-size: 1.1rem;
    color: var(--medium-grey);
    line-height: 1.6;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
}

.card {
    background: var(--glass-bg, rgba(255, 255, 255, 0.6));
    backdrop-filter: blur(20px);
    border: var(--glass-border, 1px solid rgba(255, 255, 255, 0.5));
    border-radius: 1.5rem;
    padding: 2.5rem;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl), var(--shadow-glow-blue);
    border-color: rgba(59, 130, 246, 0.3);
}

.iconWrapper {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary-blue);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
}

.card:hover .iconWrapper {
    background: var(--primary-blue);
    color: white;
    transform: scale(1.1) rotate(5deg);
}

.cardTitle {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--deep-navy);
}

.cardDesc {
    color: var(--medium-grey);
    line-height: 1.6;
    font-size: 0.95rem;
}

/* Internal Glow Effect */
.cardGlow {
    position: absolute;
    top: -50px;
    right: -50px;
    width: 150px;
    height: 150px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.2) 0%, transparent 70%);
    filter: blur(20px);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
}

.card:hover .cardGlow {
    opacity: 1;
}

@media (max-width: 640px) {
    .section {
        padding: 4rem 1.5rem;
    }

    .title {
        font-size: 2rem;
    }
}</content>
