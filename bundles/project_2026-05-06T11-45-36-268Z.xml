    <file path="app\dashboard\shared-dashboard.module.css" type="code">
      <content>/* ============================
   CANDIDATE DASHBOARD PAGES
   ============================ */

.headerStats {
    display: flex;
    gap: 1rem;
}

.tabScroll {
    display: flex;
    gap: 0.5rem;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 1px;
    margin-bottom: 2rem;
}

.searchGrid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2rem;
    align-items: start;
}

.dash {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
    padding: 0 clamp(0.5rem, 2vw, 0);
}

.pageHeader {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
}

.pageHeaderContent {
    flex: 1;
    min-width: 200px;
}

.pageHeaderTitle {
    font-size: 1.75rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
}

.pageHeaderSub {
    color: #64748b;
    font-size: 0.9rem;
    margin-top: 0.25rem;
}

.greet {
    margin-bottom: 0.5rem;
}

.greetTitle {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
}

.greetSub {
    font-size: 0.8rem;
    color: #94a3b8;
    margin-top: 0.1rem;
}

/* Stats */
.stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(clamp(150px, 100%, 280px), 1fr));
    gap: clamp(0.5rem, 1.5vw, 1rem);
}

.stat {
    background: var(--background);
    border: 1px solid #eef0f2;
    border-radius: 12px;
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    transition: box-shadow 0.2s ease;
}

.stat:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.statTop {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.statLabel {
    font-size: 0.72rem;
    color: #94a3b8;
    font-weight: 500;
}

.statIconBox {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
}

.statVal {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f172a;
}

.statChange {
    font-size: 0.68rem;
    color: #10b981;
    font-weight: 600;
}

.statHint {
    font-size: 0.68rem;
    color: #94a3b8;
}

/* Main grid */
.mainGrid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 0.75rem;
}

.leftCol {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.rightCol {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

/* Cards */
.card {
    background: var(--background);
    border: 1px solid #eef0f2;
    border-radius: 12px;
    padding: clamp(1rem, 3vw, 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.cardHead {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.cardTitle {
    font-size: 0.88rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
}

.viewAll {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--primary-blue);
    background: none;
    border: none;
    cursor: pointer;
}

.viewAll:hover {
    text-decoration: underline;
}

.moreBtn {
    background: none;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
}

/* Job cards */
.jobCard {
    display: flex;
    gap: 0.75rem;
    padding: 0.85rem;
    border: 1px solid #f1f5f9;
    border-radius: 10px;
    transition: all 0.15s ease;
}

.jobCard:hover {
    background: #fafbfc;
    border-color: #e2e8f0;
}

.jobIcon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    color: #475569;
    flex-shrink: 0;
}

.jobBody {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
}

.jobRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.jobTitle {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0f172a;
}

.matchBadge {
    font-size: 0.62rem;
    font-weight: 700;
    color: #10b981;
    background: #f0fdf4;
    padding: 0.15rem 0.5rem;
    border-radius: 12px;
    white-space: nowrap;
}

.jobMeta {
    font-size: 0.7rem;
    color: #94a3b8;
}

.jobTags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.15rem;
}

.tag {
    font-size: 0.62rem;
    font-weight: 500;
    color: #475569;
    background: #f5f7fa;
    padding: 0.15rem 0.5rem;
    border-radius: 5px;
    border: 1px solid #eef0f2;
}

.jobFoot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.3rem;
}

.jobTime {
    font-size: 0.65rem;
    color: #b0b8c4;
}

.viewJobBtn {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--primary-blue);
    background: #eff6ff;
    border: none;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
}

.viewJobBtn:hover {
    background: var(--primary-blue);
    color: white;
}

/* Activity */
.actItem {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid #f5f7fa;
}

.actItem:last-of-type {
    border-bottom: none;
}

.actIcon {
    font-size: 0.95rem;
    flex-shrink: 0;
}

.actContent {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.actText {
    font-size: 0.78rem;
    color: #374151;
}

.actText b {
    font-weight: 700;
    color: #0f172a;
}

.actTime {
    font-size: 0.65rem;
    color: #b0b8c4;
}

.actAction {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--primary-blue);
    background: none;
    border: none;
    cursor: pointer;
}

.viewAllFooter {
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    background: none;
    border: none;
    cursor: pointer;
    padding-top: 0.3rem;
    align-self: center;
}

.viewAllFooter:hover {
    color: var(--primary-blue);
}

/* Schedule */
.scheduleItem {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem;
    border-left: 3px solid var(--primary-blue);
    border-radius: 0 8px 8px 0;
    background: #fafbfc;
}

.schedBadge {
    font-size: 0.6rem;
    font-weight: 800;
    color: var(--primary-blue);
    letter-spacing: 0.04em;
}

.schedTitle {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0f172a;
}

.schedMeta {
    font-size: 0.7rem;
    color: #94a3b8;
}

.schedDetails {
    display: flex;
    gap: 0.75rem;
    font-size: 0.68rem;
    color: #64748b;
    margin-top: 0.15rem;
}

.joinBtn {
    margin-top: 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    background: #f5f7fa;
    border: 1px solid #eef0f2;
    border-radius: 6px;
    padding: 0.3rem 0.7rem;
    color: #374151;
    cursor: pointer;
    align-self: flex-start;
    transition: all 0.15s ease;
}

.joinBtn:hover {
    background: var(--primary-blue);
    color: white;
    border-color: var(--primary-blue);
}

.schedDateBlock {
    display: flex;
    align-items: center;
    gap: 0.3rem;
}

.schedDay {
    font-size: 0.62rem;
    font-weight: 700;
    color: #94a3b8;
}

.schedNum {
    font-size: 1.1rem;
    font-weight: 800;
    color: #0f172a;
}

/* Quick Actions */
.quickAction {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.7rem;
    background: var(--background);
    border: 1px solid #eef0f2;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
    width: 100%;
    font-family: inherit;
    color: #374151;
}

.quickAction:hover {
    background: #f5f7fa;
    border-color: #e2e8f0;
}

.qaIcon {
    font-size: 0.95rem;
}

.qaLabel {
    flex: 1;
    font-size: 0.78rem;
    font-weight: 500;
    text-align: left;
}

/* Featured */
.featuredCard {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border-radius: 12px;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: white;
}

.featuredLabel {
    font-size: 0.58rem;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.featuredName {
    font-size: 1rem;
    font-weight: 800;
}

.featuredLink {
    font-size: 0.72rem;
    font-weight: 600;
    color: #60a5fa;
    background: none;
    border: none;
    cursor: pointer;
    align-self: flex-start;
    padding: 0;
    margin-top: 0.15rem;
}

/* ── Jobs Page ── */
.jobsListGrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 1rem;
    margin-top: 0.5rem;
}

.jobsPage {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.searchRow {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.searchBarFull {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    background: var(--background);
    border: 1px solid #eef0f2;
    border-radius: 9px;
    min-width: 200px;
}

.searchBarFull input {
    border: none;
    background: none;
    outline: none;
    font-size: 0.82rem;
    color: #0f172a;
    font-family: inherit;
    flex: 1;
}

.searchBarFull input::placeholder {
    color: #b0b8c4;
}

.filterBtn {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.75rem;
    background: var(--background);
    border: 1px solid #eef0f2;
    border-radius: 9px;
    font-size: 0.78rem;
    font-weight: 500;
