          totalApplications: totalApplications || 0,
          totalCandidates: totalCandidates || 0,
          totalRecruiters: totalRecruiters || 0,
          avgTimeToHire: &apos;12 days&apos;,
          appsPerJob: totalJobs ? (totalApplications || 0) / (totalJobs || 0) : 0,
        },
        alerts: {
