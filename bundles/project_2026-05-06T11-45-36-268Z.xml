    flex-direction: column;
    gap: 0.1rem;
}

.jobListTitle {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0f172a;
}

.jobListCompany {
    font-size: 0.7rem;
    color: #64748b;
}

.jobListMeta {
    display: flex;
