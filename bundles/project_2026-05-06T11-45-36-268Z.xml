}

.filterTab:hover {
    background: rgba(255, 255, 255, 0.2);
}

.filterTabActive {
    background: white !important;
    color: var(--cobalt-blue) !important;
    border-color: white !important;
}

/* Stats bar */
.statsBar {
    background: var(--ocean-deep, #1565C0);
    border-top: 1px solid rgba(144, 202, 249, 0.2);
}

.statsInner {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(24px, 5vh, 28px) 16px;
    gap: 0;
}

.statDiv {
    width: 1px;
    height: 40px;
    background: rgba(144, 202, 249, 0.3);
    margin: 0 40px;
}

.statItem {
    text-align: center;
}

.statVal {
    font-size: 1.7rem;
    font-weight: 800;
    color: white;
    line-height: 1;
}

.statLabel {
    font-size: 0.75rem;
    color: var(--sky-blue, #90CAF9);
    margin-top: 2px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

/* ─── Cards Section ── */
.cardsSection {
    padding: clamp(32px, 6vh, 52px) 16px 72px;
}

.cardsGrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(280px, 100%, 360px), 1fr));
    gap: 24px;
}

.card {
    background: white;
    border-radius: 18px;
    padding: 28px;
    border: 1px solid var(--sky-blue, #90CAF9);
    display: flex;
    flex-direction: column;
    gap: 18px;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.10);
}

.cardHead {
    display: flex;
    align-items: center;
    gap: 14px;
}

.cardLogo {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: 0.88rem;
    flex-shrink: 0;
}

.cardCompany {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--cobalt-blue);
}

.cardSize {
    font-size: 0.8rem;
    color: var(--medium-grey);
    margin-top: 2px;
}

.section {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.sectionLbl {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--medium-grey, #475569);
}

.sectionTxt {
    font-size: 0.88rem;
    color: var(--medium-grey);
    line-height: 1.6;
    margin: 0;
}

/* Metric */
.metricBox {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--alice-blue, #E3F2FD);
    border-radius: 10px;
    padding: 14px 18px;
    border-left: 4px solid var(--primary-blue, #007BFF);
}

.metricVal {
    font-size: 2rem;
    font-weight: 800;
    color: var(--cobalt-blue);
    line-height: 1;
}

.metricLabel {
    font-size: 0.8rem;
    color: var(--medium-grey);
    font-weight: 500;
    margin-top: 2px;
}

/* Quote */
.quoteBlock {
    background: var(--light-ice-blue);
    border-radius: 10px;
    padding: 14px 16px;
}

.quoteText {
    font-size: 0.88rem;
    font-style: italic;
    color: var(--medium-grey);
    margin: 0 0 6px;
    line-height: 1.6;
}

.quotePerson {
    font-size: 0.8rem;
    color: var(--ocean-deep);
    font-weight: 600;
}

.quotePerson em {
    font-style: normal;
    color: var(--medium-grey);
    font-weight: 400;
}

.readMore {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary-blue);
    text-decoration: none;
    transition: color 0.15s;
    margin-top: auto;
}

.readMore:hover {
    color: var(--cobalt-blue);
}

.emptyState {
    text-align: center;
    padding: 60px 24px;
    font-size: 1.05rem;
    color: var(--medium-grey);
}

/* ─── CTA Strip ── */
.ctaStrip {
    background: linear-gradient(135deg, var(--primary-blue, #007BFF) 0%, var(--dodger-blue, #2196F3) 100%);
    padding: 56px 0;
    text-align: center;
}

.ctaTitle {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: white;
    margin: 0 0 32px;
}

.ctaBtns {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
}

.ctaPrimary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: white;
    color: var(--primary-blue);
    padding: 14px 28px;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}

.ctaPrimary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
}

.ctaSecondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: white;
    padding: 14px 28px;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
}

.ctaSecondary:hover {
    background: rgba(255, 255, 255, 0.25);
}

/* ─── Responsive ── */
@media (max-width: 768px) {
    .cardsGrid {
        grid-template-columns: 1fr;
    }

    .statsInner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        padding: 28px 16px;
    }

    .statDiv {
        display: none;
    }
}

@media (max-width: 480px) {
    .statsInner {
        grid-template-columns: 1fr 1fr;
    }
}</content>
