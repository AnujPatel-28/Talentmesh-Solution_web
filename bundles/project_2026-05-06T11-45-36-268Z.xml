    gap: 0.5rem;
}

.kanbanLogo {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.55rem;
    font-weight: 700;
    flex-shrink: 0;
    background: #f1f5f9;
    color: #475569;
}

.kanbanCompany {
    font-size: 0.78rem;
    font-weight: 700;
    color: #0f172a;
}

.kanbanRole {
    font-size: 0.68rem;
    color: #94a3b8;
}

.kanbanExtra {
    font-size: 0.62rem;
    color: #94a3b8;
    margin-top: 0.15rem;
}

.kanbanTag {
    display: inline-block;
    font-size: 0.58rem;
    font-weight: 600;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
}

.kanbanLink {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--primary-blue);
    text-decoration: none;
    margin-top: 0.15rem;
}

.offerBanner {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 6px;
    padding: 0.35rem 0.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.15rem;
}

.offerLabel {
    font-size: 0.62rem;
    font-weight: 700;
    color: #10b981;
}

.offerAmount {
    font-size: 0.72rem;
    font-weight: 800;
    color: #0f172a;
}

.offerExpiry {
    font-size: 0.58rem;
    color: #10b981;
