                            &lt;/React.Fragment&gt;
                        ))}
                    &lt;/div&gt;
                &lt;/div&gt;
            &lt;/section&gt;

            {/* ── TESTIMONIALS ── */}
            &lt;section className={styles.trustSection}&gt;
                &lt;div className=&quot;premium-container&quot;&gt;
                    &lt;h2 className={styles.sectionTitle}&gt;What Candidates Say&lt;/h2&gt;
                    &lt;div className={styles.testiGrid}&gt;
