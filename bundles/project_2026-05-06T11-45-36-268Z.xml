    <file path="app\employers\products\products.module.css" type="code">
      <content>.page {
    padding-top: 68px;
    min-height: 100vh;
    background: var(--light-ice-blue, #F0F7FF);
}

/* ─── Hero ── */
.hero {
    background: white;
    padding: 60px 0 48px;
    text-align: center;
    border-bottom: 1px solid var(--sky-blue);
}

.heroTitle {
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    font-weight: 800;
    color: var(--cobalt-blue);
    margin: 0 0 14px;
}

.heroSub {
    font-size: 1.05rem;
    color: var(--medium-grey);
    margin: 0 0 32px;
}

/* Toggle */
.toggleWrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
}

.toggleLabel {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--medium-grey);
    display: flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
}

.toggleLabelActive {
    color: var(--cobalt-blue);
}

.togglePill {
    width: 48px;
    height: 26px;
    border-radius: 999px;
    background: var(--alice-blue);
    border: 1px solid var(--sky-blue);
    cursor: pointer;
    position: relative;
    transition: background 0.25s ease;
}

.togglePillOn {
    background: var(--primary-blue);
    border-color: var(--primary-blue);
}

.toggleThumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    transition: left 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.togglePillOn .toggleThumb {
    left: 25px;
}

.saveBadge {
    background: var(--dodger-blue);
    color: white;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 999px;
    letter-spacing: 0.04em;
}

/* ─── Pricing Section ── */
.pricingSection {
    padding: 52px 0 64px;
}

.pricingGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
}

.planCard {
    background: white;
    border-radius: 18px;
    padding: 32px 28px;
    border: 1px solid var(--sky-blue);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.planCard:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
}

.planCardFeatured {
    background: var(--alice-blue, #E3F2FD);
    border-color: var(--primary-blue);
    border-top: 4px solid var(--primary-blue);
}

.popularRibbon {
    position: absolute;
    top: 16px;
    right: 16px;
    background: var(--dodger-blue, #2196F3);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 12px;
    border-radius: 999px;
}

.planName {
    font-size: 1rem;
    font-weight: 700;
    color: var(--medium-grey, #475569);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 16px;
}

.planPrice {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 2px;
}

.priceNum {
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--cobalt-blue);
    line-height: 1;
    transition: all 0.3s ease;
}

.pricePer {
    font-size: 0.82rem;
    color: var(--medium-grey);
}

.planPeriod {
    font-size: 0.8rem;
    color: var(--medium-grey);
    margin-bottom: 12px;
}

.planDesc {
    font-size: 0.88rem;
    color: var(--medium-grey);
    margin: 0 0 24px;
    line-height: 1.55;
    border-bottom: 1px solid var(--sky-blue);
    padding-bottom: 20px;
}

.featureList {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
}

.featureItem {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--medium-grey);
}

.featureCheck {
    color: var(--primary-blue);
    flex-shrink: 0;
    margin-top: 1px;
}

.planCta {
    width: 100%;
    padding: 13px 20px;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
    border: none;
    margin-top: auto;
}

.cta_outline {
    background: white;
    color: var(--primary-blue);
    border: 2px solid var(--primary-blue);
}

.cta_outline:hover {
    background: var(--alice-blue);
}

.cta_filled {
    background: linear-gradient(135deg, var(--primary-blue), var(--dodger-blue));
    color: white;
}

.cta_filled:hover {
    box-shadow: 0 6px 20px rgba(0, 123, 255, 0.4);
    transform: translateY(-1px);
}

.cta_dark {
    background: var(--ocean-deep, #1565C0);
    color: white;
}

.cta_dark:hover {
    background: var(--cobalt-blue);
}

/* ─── Table Section ── */
.tableSection {
    background: white;
    padding: 64px 0;
}

.sectionTitle {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--cobalt-blue);
    text-align: center;
    margin: 0 0 36px;
}

.tableWrap {
    overflow-x: auto;
    border-radius: 14px;
    border: 1px solid var(--sky-blue);
}

.table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
}

.tableHead {
    background: var(--cobalt-blue, #0D47A1);
    color: white;
}

.tableHead th {
    padding: 14px 20px;
    text-align: center;
    font-weight: 700;
    font-size: 0.9rem;
}

.thFeature {
    text-align: left !important;
    width: 35%;
}

.thGrowth {
    background: rgba(30, 136, 229, 0.3);
    color: var(--cool-sky-2, #42A5F5);
}

.rowEven {
    background: white;
}

.rowOdd {
    background: var(--light-ice-blue, #F0F7FF);
}

.tdFeature {
    padding: 13px 20px;
    font-weight: 600;
    color: var(--medium-grey);
}

.tdVal {
    text-align: center;
    padding: 13px 20px;
    color: var(--medium-grey);
}

.tdGrowth {
    background: rgba(227, 242, 253, 0.5);
}

.check {
    color: var(--dodger-blue);
    font-size: 1rem;
    font-weight: 700;
}

.dash {
    color: rgba(71, 85, 105, 0.45);
    font-size: 1rem;
}

/* ─── FAQ Section ── */
.faqSection {
    background: var(--light-ice-blue);
    padding: 64px 0;
}

.faqList {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
}

.faqItem {
    border-bottom: 1px solid #BBDEFB;
}

.faqItem:last-child {
    border-bottom: none;
}

.faqQ {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 20px 0;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.97rem;
    font-weight: 700;
    color: var(--cobalt-blue);
    text-align: left;
    font-family: inherit;
    gap: 12px;
}

.faqChev {
    color: var(--primary-blue);
    flex-shrink: 0;
    transition: transform 0.25s ease;
    line-height: 0;
}

.faqChevOpen {
    transform: rotate(180deg);
}

.faqA {
    padding: 0 0 20px 0;
    font-size: 0.9rem;
    color: var(--medium-grey);
    line-height: 1.65;
    background: var(--light-ice-blue);
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 4px;
}

/* ─── Responsive ── */
@media (max-width: 1024px) {
    .pricingGrid {
        grid-template-columns: 1fr;
        max-width: 480px;
        margin: 0 auto;
    }
}

@media (max-width: 640px) {
    .tableSection {
        padding: 40px 0;
    }

    .pricingSection {
        padding: 32px 0 40px;
    }
