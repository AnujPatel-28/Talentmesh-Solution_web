import ApplyModal from &apos;@/components/candidate/ApplyModal&apos;;
import styles from &apos;@/app/browse-jobs/[id]/jobDetail.module.css&apos;;

// ─── Icons ──────────────────────────────────────────────────────────────────────
const Ico = {
