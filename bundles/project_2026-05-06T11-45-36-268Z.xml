    text-decoration: none;
    transition: gap 0.2s;
}

.readMoreBtn:hover {
    gap: 12px;
}

/* Articles Grid */
.articlesSection {
    padding: clamp(3rem, 6vh, 5rem) 16px 4rem;
}

.articlesGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
}

.articleCard {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
}

.articleCard::after {
    content: &apos;&apos;;
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #007BFF, #60a5fa, #818cf8);
    transform: scaleX(0);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: left;
}

.articleCard:hover {
    transform: translateY(-8px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1);
    border-color: rgba(0, 123, 255, 0.15);
}

.articleCard:hover::after {
    transform: scaleX(1);
}

.cardBanner {
    height: 180px;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 1.25rem;
    background: #0f172a;
    overflow: hidden;
}

.cardImg {
    object-fit: cover;
    opacity: 0.5;
    transition: transform 0.6s ease;
}

.articleCard:hover .cardImg {
    transform: scale(1.1);
}

.cardBannerEmoji {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    opacity: 0.5;
}

.catTag {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: 50px;
    border: 1px solid rgba(255, 255, 255, 0.3);
}

.cardBody {
    padding: 1.75rem;
}

.cardDate {
    font-size: 0.78rem;
    color: var(--medium-grey);
    margin-bottom: 0.75rem;
}

.cardTitle {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--deep-navy);
    line-height: 1.35;
    margin-bottom: 0.75rem;
}

.cardDesc {
    font-size: 0.875rem;
    color: var(--medium-grey);
    line-height: 1.65;
    margin-bottom: 1.5rem;
}

.readLink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--primary-blue);
    font-weight: 800;
    font-size: 0.85rem;
    text-decoration: none;
    transition: gap 0.2s;
}

.readLink:hover {
    gap: 10px;
}

/* Newsletter */
.newsletterSection {
    padding: 4rem 0 8rem;
}

.newsletterCard {
    background: var(--gradient-premium);
    border-radius: clamp(24px, 5vw, 40px);
    padding: clamp(4rem, 10vh, 6rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    color: #fff;
}

.newsletterCard h2 {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 900;
    margin-bottom: 1rem;
}

.newsletterCard p {
    opacity: 0.75;
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0 auto 3rem;
    line-height: 1.7;
}

.emailForm {
    display: flex;
    gap: 0.75rem;
    max-width: 500px;
    margin: 0 auto;
}

.emailInput {
    flex: 1;
    padding: 1rem 1.5rem;
    border-radius: 14px;
    border: none;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 0.95rem;
    outline: none;
    backdrop-filter: blur(10px);
}

.emailInput::placeholder {
    color: rgba(255, 255, 255, 0.5);
}

.subscribeBtn {
    background: #fff;
    color: var(--primary-blue);
    border: none;
    padding: 1rem 2rem;
    border-radius: 14px;
    font-weight: 800;
    font-size: 0.95rem;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.2s;
}

.subscribeBtn:hover {
    transform: translateY(-2px);
}

/* Responsive */
@media (max-width: 1024px) {
    .articlesGrid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .hero {
        padding: 7rem 0 5rem;
    }

    .featuredCard {
        grid-template-columns: 1fr;
    }

    .featuredBanner {
        min-height: 200px;
    }

    .articlesGrid {
        grid-template-columns: 1fr;
    }

    .newsletterCard {
        padding: 4rem 2rem;
        border-radius: 24px;
    }

    .emailForm {
        flex-direction: column;
    }
}</content>
