}

export const AdminButton: React.FC&lt;AdminButtonProps&gt; = ({ 
  children, 
  variant = &apos;primary&apos;, 
  isLoading, 
  ...props 
}) =&gt; {
  const getStyles = () =&gt; {
    switch (variant) {
