                            &lt;/div&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
            &lt;/section&gt;

            {/* ─── WHEN DOES RPO MAKE SENSE ────────────────────────────────── */}
