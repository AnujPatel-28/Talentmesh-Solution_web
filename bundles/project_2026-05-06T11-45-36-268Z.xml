.solutionGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
}

.solutionCard {
    background: white;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: 32px;
    border: 1px solid #f1f5f9;
    transition: var(--transition-smooth);
}

.solutionCard:hover {
    transform: translateY(-10px);
    box-shadow: var(--shadow-xl);
    border-color: var(--primary-blue);
}

.solutionTitle {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--deep-navy);
    margin-bottom: 1.5rem;
}

.solutionDesc {
    color: var(--medium-grey);
    line-height: 1.7;
    margin-bottom: 3rem;
}

.actionLink {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--primary-blue);
    font-weight: 800;
    text-decoration: none;
    font-size: 0.95rem;
}

/* CTA */
.ctaSection {
    padding: clamp(4rem, 12vh, 10rem) 16px;
}

.ctaBox {
    background: linear-gradient(135deg, var(--deep-navy) 0%, #001f3f 100%);
    border-radius: clamp(24px, 5vw, 48px);
    padding: clamp(4rem, 15vh, 10rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    color: white;
    position: relative;
    overflow: hidden;
}

.ctaBox::before {
    content: &apos;&apos;;
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at center, rgba(0, 123, 255, 0.2) 0%, transparent 70%);
}

.ctaTitle {
    font-size: 4rem;
    font-weight: 900;
    margin-bottom: 2rem;
    position: relative;
    z-index: 2;
}

.ctaBtn {
    background: var(--primary-blue);
    color: white;
    padding: 1.5rem 4rem;
    border-radius: 18px;
    font-weight: 900;
    text-decoration: none;
    display: inline-block;
    transition: var(--transition-smooth);
    box-shadow: 0 20px 40px rgba(0, 123, 255, 0.3);
}

@media (max-width: 1100px) {
    .commandGrid {
        grid-template-columns: 1fr;
        gap: 5rem;
    }

    .solutionGrid {
        grid-template-columns: repeat(2, 1fr);
    }

    .dashboardMockup {
        grid-template-columns: 1fr;
        gap: 2rem;
    }
}

@media (max-width: 768px) {
    .heroTitle {
        font-size: 3rem;
    }

    .solutionGrid {
        grid-template-columns: 1fr;
    }

    .ctaTitle {
        font-size: 2.5rem;
    }

    .commandTitle {
        font-size: 2.5rem;
    }
}</content>
