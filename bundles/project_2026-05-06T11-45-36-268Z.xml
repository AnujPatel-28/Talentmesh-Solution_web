    <file path="components\sections\JobListings.module.css" type="code">
      <content>/* ─── Section ─────────────────────────────────────────────── */
.section {
    padding: 7rem 2rem;
    background: #f8fafc;
    color: #111111;
    overflow-x: hidden;
}

.container {
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
}

/* ─── Headline ────────────────────────────────────────────── */
.headlineGroup {
    text-align: center;
    margin-bottom: 3rem;
}

.title {
    font-size: 2.85rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 0.75rem;
}

.highlight {
    color: #3b82f6;
}

.subtitle {
    font-size: 1.05rem;
    color: #94a3b8;
    margin: 0;
    font-weight: 400;
}

/* ─── Mock App Window ─────────────────────────────────────── */
.appWindow {
    background: #ffffff;
    border-radius: 1.5rem;
    box-shadow:
        0 25px 60px -12px rgba(0, 0, 0, 0.12),
        0 8px 20px -8px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(226, 232, 240, 0.8);
    overflow: hidden;
}

.windowBar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}

.dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
    opacity: 0.85;
}

/* ─── Layout ──────────────────────────────────────────────── */
.layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 460px;
}

/* ─── Sidebar ─────────────────────────────────────────────── */
.sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.5rem 1rem;
    border-right: 1px solid #f1f5f9;
    background: #fafafa;
}

.sidebarLabel {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #94a3b8;
    padding: 0 0.75rem;
    margin: 0 0 0.5rem;
}

.categoryItem {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    border-radius: 0.65rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
    color: #475569;
    font-size: 0.875rem;
    font-family: inherit;
    width: 100%;
    font-weight: 500;
}

.categoryItem:hover {
    background: #f1f5f9;
    color: #1e293b;
}

.categoryActive {
    background: #eff6ff !important;
    color: #2563eb !important;
    font-weight: 600;
}

.categoryActive .categoryIcon {
    color: #2563eb !important;
}

.categoryIcon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    transition: color 0.18s;
}

.categoryLabel {
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ─── Jobs Panel ──────────────────────────────────────────── */
.jobsPanel {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
}

.jobList {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
}

/* ─── Job Card ────────────────────────────────────────────── */
.jobCard {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: white;
    border: 1px solid #e8edf2;
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    gap: 1rem;
    cursor: pointer;
}

.jobCard:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.12), 0 4px 10px -5px rgba(59, 130, 246, 0.08);
    border-color: #bfdbfe;
}

.jobInfo {
    display: flex;
    align-items: center;
    gap: 1.125rem;
    flex: 1;
    min-width: 0;
}

.jobLogo {
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    flex-shrink: 0;
    letter-spacing: 0.03em;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.jobDetails {
    min-width: 0;
    flex: 1;
}

.jobTitle {
    font-size: 1rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.35rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ─── Metadata row ────────────────────────────────────────── */
.jobMeta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.metaItem {
    font-size: 0.8rem;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
}

.metaDot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #cbd5e1;
    flex-shrink: 0;
}

/* ─── Right side: badge + button ─────────────────────────── */
.jobActions {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    flex-shrink: 0;
}

/* Pill badges */
.badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    white-space: nowrap;
}

.badgeBlue {
    background: #dbeafe;
    color: #1d4ed8;
}

.badgeGray {
    background: #f1f5f9;
    color: #475569;
}

.badgeGreen {
    background: #dcfce7;
    color: #15803d;
}

.badgeOrange {
    background: #ffedd5;
    color: #c2410c;
}

.badgePurple {
    background: #f3e8ff;
    color: #7e22ce;
}

/* Ghost &quot;View Job&quot; button */
.viewBtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1.25rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 0.625rem;
    color: #334155;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    background: white;
}

.viewBtn:hover {
    border-color: #3b82f6;
    color: #ffffff;
    background: #3b82f6;
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
}

/* Empty state */
.emptyState {
    text-align: center;
    color: #94a3b8;
    padding: 3rem 2rem;
    font-size: 0.95rem;
}

/* ─── CTA ─────────────────────────────────────────────────── */
.ctaWrapper {
    display: flex;
    justify-content: center;
    padding-top: 2.5rem;
}

.browseBtn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 2.25rem;
    background: #3b82f6;
    color: #ffffff;
    border-radius: 9999px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.35);
    letter-spacing: -0.01em;
}

.browseBtn:hover {
    background: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(59, 130, 246, 0.4);
}

/* ─── Responsive ──────────────────────────────────────────── */
@media (max-width: 900px) {
    .layout {
        grid-template-columns: 1fr;
    }

    /* Horizontal scrollable chip strip */
    .sidebar {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        overflow-x: auto;
        gap: 0.5rem;
        padding: 1rem 1rem 0.75rem;
        border-right: none;
        border-bottom: 1px solid #e2e8f0;
        background: #fafafa;
        /* hide scrollbar visually but keep scroll */
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .sidebar::-webkit-scrollbar {
        display: none;
    }

    .sidebarLabel {
        display: none;
    }

    .categoryItem {
        flex-shrink: 0;
        width: auto;
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        border: 1.5px solid #e2e8f0;
        background: white;
        font-size: 0.82rem;
        gap: 0.5rem;
        white-space: nowrap;
    }

    .categoryItem:hover {
        border-color: #93c5fd;
        background: #eff6ff;
        transform: none;
    }

    .categoryActive {
        border-color: #3b82f6 !important;
        background: #eff6ff !important;
    }

    .categoryIcon {
        width: 16px;
        height: 16px;
    }

    .categoryLabel {
        overflow: visible;
        text-overflow: unset;
        white-space: nowrap;
    }
}

@media (max-width: 640px) {
    .section {
        padding: 4rem 1rem;
    }

    .title {
        font-size: 1.85rem;
    }

    .subtitle {
        font-size: 0.9rem;
    }

    .appWindow {
        border-radius: 1rem;
    }

    .jobsPanel {
        padding: 1rem;
    }

    .jobCard {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.875rem;
        padding: 1rem;
    }

    .jobInfo {
        gap: 0.875rem;
    }

    .jobTitle {
        font-size: 0.95rem;
    }

    .jobActions {
        width: 100%;
        justify-content: space-between;
        border-top: 1px solid #f1f5f9;
        padding-top: 0.75rem;
    }

    .jobMeta {
        gap: 0.3rem;
        flex-wrap: wrap;
    }

    .metaDot {
        display: none;
    }

    .metaItem {
        font-size: 0.75rem;
    }

    .browseBtn {
        font-size: 0.9rem;
        padding: 0.8rem 1.75rem;
    }
}</content>
