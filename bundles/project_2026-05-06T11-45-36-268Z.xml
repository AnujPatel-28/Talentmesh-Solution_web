            console.error(&apos;Save toggle failed:&apos;, err);
        }
    };

    if (loading) {
        return &lt;div style={{ padding: &apos;80px 0&apos;, textAlign: &apos;center&apos; }}&gt;Loading job details...&lt;/div&gt;;
    }

