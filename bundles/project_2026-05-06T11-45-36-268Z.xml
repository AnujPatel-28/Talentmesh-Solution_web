}

/* ── Profile Page ── */
.profilePage {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 0.75rem;
}

.profileSidebar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.profileCard {
    background: var(--background);
    border: 1px solid #eef0f2;
    border-radius: 12px;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
}

.profileAvatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-blue), #60a5fa);
    color: white;
    font-size: 1.6rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.onlineDot {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 12px;
    height: 12px;
    background: #10b981;
    border-radius: 50%;
    border: 2.5px solid white;
}

.profileName {
    font-size: 1rem;
    font-weight: 800;
    color: #0f172a;
}

.profileRole {
    font-size: 0.78rem;
    color: #64748b;
}

.profileLoc {
    font-size: 0.72rem;
    color: #94a3b8;
}

.profileTags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    justify-content: center;
}

.editProfileBtn {
    width: 100%;
    padding: 0.5rem;
    background: #f5f7fa;
    border: 1px solid #eef0f2;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #374151;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
}

.editProfileBtn:hover {
    background: #eef0f2;
}

.scoreCard {
    background: var(--background);
    border: 1px solid #eef0f2;
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
}

.scoreHeader {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
}

.scoreTitle {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0f172a;
}

.scoreBadge {
    font-size: 0.58rem;
    font-weight: 700;
    color: var(--primary-blue);
    background: #eff6ff;
    padding: 0.1rem 0.4rem;
    border-radius: 8px;
}

.scoreRing {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 6px solid #eef0f2;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    position: relative;
    margin: 0.5rem 0;
}

.scoreRingFill {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 6px solid var(--primary-blue);
    border-top-color: transparent;
    border-right-color: transparent;
    transform: rotate(45deg);
}

.scoreNum {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f172a;
}

.scoreSub {
    font-size: 0.6rem;
    font-weight: 600;
    color: var(--primary-blue);
}

.scoreText {
    font-size: 0.68rem;
    color: #94a3b8;
    text-align: center;
}

.openToggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-top: 0.5rem;
    border-top: 1px solid #f1f5f9;
}

.openLabel {
    font-size: 0.75rem;
    font-weight: 600;
    color: #0f172a;
}

.openHint {
    font-size: 0.62rem;
    color: #94a3b8;
}

.toggleSwitch {
    width: 38px;
    height: 20px;
    background: var(--primary-blue);
    border-radius: 10px;
    position: relative;
    cursor: pointer;
    border: none;
}

.toggleDot {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 16px;
    height: 16px;
    background: var(--background);
    border-radius: 50%;
    transition: all 0.2s ease;
}

.contactCard {
    background: var(--background);
    border: 1px solid #eef0f2;
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.contactTitle {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0f172a;
}

.contactItem {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.contactIcon {
    font-size: 0.85rem;
    flex-shrink: 0;
}

.contactMeta {
    display: flex;
    flex-direction: column;
}

.contactLabel {
    font-size: 0.62rem;
    color: #94a3b8;
}

.contactValue {
    font-size: 0.75rem;
    font-weight: 500;
    color: #0f172a;
}

.contactLink {
    color: var(--primary-blue);
    text-decoration: none;
}

/* Profile main content */
.profileMain {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.profileActions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
}

.profileActionCard {
    background: var(--background);
    border: 1px solid #eef0f2;
    border-radius: 10px;
    padding: 0.9rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    transition: all 0.15s ease;
}

.profileActionCard:hover {
    border-color: #e2e8f0;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.03);
}

.profileActionLabel {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0f172a;
}

.profileActionHint {
    font-size: 0.68rem;
    color: #94a3b8;
}

.profileSection {
    background: var(--background);
    border: 1px solid #eef0f2;
    border-radius: 12px;
    padding: 1.1rem;
}

.sectionHead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.65rem;
}

.sectionTitle {
    font-size: 0.88rem;
    font-weight: 700;
    color: #0f172a;
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.addBtn {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--primary-blue);
    background: none;
    border: none;
    cursor: pointer;
}

.expItem {
    display: flex;
    gap: 0.6rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid #f5f7fa;
}

.expItem:last-child {
    border-bottom: none;
}

.expIcon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    color: #475569;
    flex-shrink: 0;
}

.expBody {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
}

.expTitle {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0f172a;
}

.expCompany {
    font-size: 0.72rem;
    color: #64748b;
}

.expDesc {
    font-size: 0.72rem;
    color: #94a3b8;
    line-height: 1.45;
    margin-top: 0.2rem;
}

.expTags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.2rem;
}

.skillsGrid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.skillGroup {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.skillGroupTitle {
    font-size: 0.68rem;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.skillTags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
}

.skillTag {
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--primary-blue);
    background: #eff6ff;
    padding: 0.2rem 0.55rem;
    border-radius: 5px;
}

.toolTag {
    font-size: 0.68rem;
    font-weight: 500;
    color: #475569;
    background: #f5f7fa;
    padding: 0.2rem 0.55rem;
    border-radius: 5px;
    border: 1px solid #eef0f2;
}

/* ── Responsive ── */
@media (max-width: 1024px) {
    .mainGrid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .rightCol {
        order: -1;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .jobsGrid {
        grid-template-columns: 1fr;
    }

    .kanban {
        grid-template-columns: repeat(2, 1fr);
    }

    .profilePage {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .profileSidebar, .searchGrid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }
}

@media (max-width: 768px) {
    .stats {
        grid-template-columns: 1fr;
    }

    .rightCol, .profileSidebar {
        grid-template-columns: 1fr;
    }

    .kanban {
        display: flex;
        overflow-x: auto;
        padding-bottom: 1rem;
        gap: 1rem;
        scroll-snap-type: x mandatory;
        margin: 0 -16px;
        padding-left: 16px;
        scrollbar-width: none;
    }

    .kanban::-webkit-scrollbar {
        display: none;
    }

    .kanbanCol {
        flex: 0 0 280px;
        scroll-snap-align: start;
    }

    .pageHeader {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }

    .headerStats {
        width: 100%;
        overflow-x: auto;
        padding-bottom: 0.5rem;
        -webkit-overflow-scrolling: touch;
    }

    .tabScroll {
        margin: 0 -1rem 1.5rem;
        padding: 0 1rem;
    }

    .profileActions {
        grid-template-columns: 1fr;
    }

    .matchPoints {
        grid-template-columns: 1fr;
    }

    .searchRow {
        flex-direction: column;
        gap: 1rem;
    }

    .searchBarFull {
        width: 100%;
    }

    .jobDetail {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        top: 20%;
        z-index: 1000;
        border-radius: 24px 24px 0 0;
        box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.2);
        transform: translateY(100%);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .jobDetailActive {
        transform: translateY(0);
    }

    .editGrid, .readRow {
        grid-template-columns: 1fr;
        flex-direction: column;
        gap: 1rem;
    }
}

@media (max-width: 480px) {
    .dash {
        padding: 0 4px;
    }

    .greetTitle {
        font-size: 1.25rem;
    }

    .statVal {
        font-size: 1.35rem;
    }

    .applyBtn {
        width: 100%;
        padding: 0.85rem;
    }

    .pageHeaderTitle {
        font-size: 1.5rem;
    }

    .headerStats {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.5rem;
    }
}

/* Profile Edit &amp; Strength Styles */
.avatarImg {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
}

.avatarOverlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    opacity: 0;
    transition: opacity 0.2s ease;
}

.profileAvatar:hover .avatarOverlay {
    opacity: 1;
}

.uploadProgressSmall {
    width: 100%;
    height: 4px;
    background: #eef0f2;
    border-radius: 2px;
    margin-top: 0.5rem;
    overflow: hidden;
}

.uploadProgress {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #eef0f2;
}

.progressFill {
    height: 100%;
    background: var(--primary-blue);
    transition: width 0.3s ease;
}

.saveBtnFull {
    width: 100%;
    padding: 0.6rem;
    background: var(--primary-blue);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 700;
