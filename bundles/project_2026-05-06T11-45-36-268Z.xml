        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .segmentCard {
        padding: 2rem 1.75rem;
        border-radius: 1.5rem;
    }

    .segmentTitle {
        font-size: 1.625rem;
        margin-bottom: 0.75rem;
    }

    .segmentDesc {
        font-size: 0.95rem;
        margin-bottom: 1.5rem;
    }

    .segmentFeatures {
        margin-bottom: 1.5rem;
    }

    .segmentAction {
        width: 100%;
        min-width: unset;
    }

    /* CTA */
    .cta {
        padding: 4rem 1rem;
    }

    .ctaCard {
        padding: 3rem 2rem;
        border-radius: 1.75rem;
    }

    .ctaTitle {
        font-size: 2rem;
        margin-bottom: 1rem;
        letter-spacing: -0.015em;
    }

    .ctaDesc {
        font-size: 1rem;
        margin-bottom: 2rem;
    }

    .ctaBtn {
        width: 100%;
        justify-content: center;
        padding: 1rem 2rem;
    }

    /* Tags */
    .tagName {
        font-size: 1rem;
    }

    /* Industries */
    .industryFlex {
        gap: 1rem 1.5rem;
    }

    /* Pricing popular card */
    .pricingCard.popular {
        transform: scale(1);
    }

    .pricingCard.popular:hover {
        transform: translateY(-5px);
    }
}

/* Mobile Small (max-width: 600px) */
@media (max-width: 600px) {
    .powerGrid {
        grid-template-columns: 1fr;
