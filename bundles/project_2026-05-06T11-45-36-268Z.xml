        &lt;/div&gt;
      &lt;/div&gt;
    );
  }

  return (
    &lt;div className={styles.page}&gt;
      &lt;header className={styles.hero}&gt;
        &lt;div className={styles.heroInfo}&gt;
          &lt;span className={styles.eyebrow}&gt;Editorial CMS&lt;/span&gt;
