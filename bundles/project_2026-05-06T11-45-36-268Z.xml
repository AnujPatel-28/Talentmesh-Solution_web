    <file path="app\contact\contact.module.css" type="code">
      <content>/* ============================
   CONTACT PAGE — TalentMesh
   Premium Minimalist Edition
   ============================ */

.page {
    min-height: 100vh;
    background: #ffffff;
    font-family: var(--font-inter, &apos;Inter&apos;, sans-serif);
    color: #0f172a;
}

/* ── Content Grid ── */
.mainLayout {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px clamp(4rem, 10vh, 8rem);
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: flex-start;
}

/* ── Left Side: Direct Contact ── */
.contactInfo {
    display: flex;
    flex-direction: column;
    gap: 0;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border-radius: 28px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid #e2e8f0;
    position: relative;
    overflow: hidden;
}

.contactInfo::before {
    content: &apos;&apos;;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, #3b82f6, #60a5fa, #818cf8);
}

.contactImageWrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
}

.contactImg {
    object-fit: cover;
}

.infoBlock {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    position: relative;
    transition: all 0.3s ease;
}

.infoBlock:last-of-type {
    border-bottom: none;
}

.infoBlock:hover {
    transform: translateX(4px);
}

.infoLabel {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #94a3b8;
}

.infoValue {
    font-size: 1.125rem;
    font-weight: 700;
    color: #0f172a;
    text-decoration: none;
    transition: color 0.2s;
}

.infoValue:hover {
    color: #3b82f6;
}

.infoSub {
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.6;
}

/* ── Social Media Links ── */
.socialSection {
    margin-top: 0.5rem;
    padding-top: 1.75rem;
}

.socialLinks {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
}

.socialIcon {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: #ffffff;
    color: #64748b;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.socialIcon:hover {
    transform: translateY(-6px) scale(1.05);
    box-shadow: 0 16px 32px -8px rgba(37, 99, 235, 0.2);
}

/* LinkedIn hover */
.socialIcon:nth-child(1):hover {
    background: #0a66c2;
    color: #fff;
    border-color: #0a66c2;
}

/* X hover */
.socialIcon:nth-child(2):hover {
    background: #0f172a;
    color: #fff;
    border-color: #0f172a;
}

/* Instagram hover */
.socialIcon:nth-child(3):hover {
    background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
    color: #fff;
    border-color: transparent;
}

.socialIcon svg {
    width: 1.25rem;
    height: 1.25rem;
}

/* ── Right Side: Form ── */
.formContainer {
    background: #ffffff;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border-radius: 32px;
    box-shadow: 0 30px 60px -12px rgba(15, 23, 42, 0.08), 0 18px 36px -18px rgba(15, 23, 42, 0.1);
    border: 1px solid rgba(241, 245, 249, 0.8);
    position: relative;
    z-index: 10;
    overflow: hidden;
}

.formContainer::before {
    content: &apos;&apos;;
    position: absolute;
    top: -80px;
    right: -80px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.06) 0%, transparent 70%);
    z-index: -1;
}

.formContainer::after {
    content: &apos;&apos;;
    position: absolute;
    bottom: -60px;
    left: -60px;
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, rgba(129, 140, 248, 0.04) 0%, transparent 70%);
    z-index: -1;
}

.form {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
}

.formRow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
}

.field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: relative;
}

.label {
    font-size: 0.72rem;
    font-weight: 800;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.input,
.textarea,
.select {
    width: 100%;
    padding: 1rem 0;
    background: transparent;
    border: none;
    border-bottom: 2px solid #f1f5f9;
    font-size: 1.05rem;
    font-family: inherit;
    color: #0f172a;
    outline: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.input:hover,
.textarea:hover,
.select:hover {
    border-color: #cbd5e1;
}

.textarea {
    min-height: 120px;
    resize: none;
    padding-top: 1.25rem;
}

.input:focus,
.textarea:focus,
.select:focus {
    border-color: #3b82f6;
