    <file path="app\onboarding\onboarding.module.css" type="code">
      <content>/* ============================
   ONBOARDING — Shared Styles
   ============================ */

.page {
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    position: relative;
    overflow: hidden;
    font-family: var(--font-inter), -apple-system, BlinkMacSystemFont, &apos;Segoe UI&apos;, sans-serif;
}

.bgGlow1 {
    position: absolute;
    top: -12%;
    right: -8%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(0, 123, 255, 0.07) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
    animation: glowPulse 20s ease-in-out infinite alternate;
}

.bgGlow2 {
    position: absolute;
    bottom: -12%;
    left: -8%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(0, 123, 255, 0.05) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
    animation: glowPulse 16s ease-in-out infinite alternate-reverse;
}

@keyframes glowPulse {
    0% {
        transform: scale(1);
        opacity: 0.7;
    }

    100% {
        transform: scale(1.15);
        opacity: 1;
    }
}

.gridOverlay {
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(0, 0, 0, 0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 0, 0, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
}

/* Card */
.card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 520px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    padding: 2rem 2.25rem;
    box-shadow:
        0 4px 6px -1px rgba(0, 0, 0, 0.03),
        0 10px 30px -5px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    animation: cardEnter 0.5s ease-out;
}

@keyframes cardEnter {
    from {
        opacity: 0;
        transform: translateY(16px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* Stepper */
.stepper {
    display: flex;
    align-items: center;
    gap: 0;
}

.stepDot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    border: 2px solid #e2e8f0;
    background: #f1f5f9;
    color: #94a3b8;
    transition: all 0.3s ease;
    flex-shrink: 0;
}

.stepDotActive {
    border-color: var(--primary-blue);
    background: var(--primary-blue);
    color: white;
    box-shadow: 0 2px 8px rgba(0, 123, 255, 0.3);
}

.stepDotDone {
    border-color: #10b981;
    background: #10b981;
    color: white;
}

.stepLine {
    flex: 1;
    height: 2px;
    background: #e2e8f0;
    margin: 0 0.35rem;
    transition: background 0.3s ease;
}

.stepLineActive {
    background: var(--primary-blue);
}

.stepLineDone {
    background: #10b981;
}

/* Header */
.header {
    text-align: center;
}

.title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
}

.subtitle {
    font-size: 0.82rem;
    color: #94a3b8;
}

/* Category / Chip Grid */
.chipGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
}

.chip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem 0.5rem;
    background: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #374151;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
    text-align: center;
}

.chip:hover {
    border-color: #66b3ff;
    background: #f0f7ff;
}

.chipSelected {
    border-color: var(--primary-blue);
    background: #e6f2ff;
    color: var(--primary-blue);
    box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.1);
}

.chipIcon {
    font-size: 1rem;
}

/* Skill Tags */
.tagWrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
}

.tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.75rem;
    background: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
}

.tag:hover {
    border-color: #66b3ff;
    color: #374151;
}

.tagSelected {
    border-color: var(--primary-blue);
    background: var(--primary-blue);
    color: white;
}

/* Upload Area */
.uploadArea {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 2rem;
    border: 2px dashed #d1d5db;
    border-radius: 14px;
    background: #fafafa;
    cursor: pointer;
    transition: all 0.25s ease;
    text-align: center;
}

.uploadArea:hover {
    border-color: var(--primary-blue);
    background: #f0f7ff;
}

.uploadAreaActive {
    border-color: #10b981;
    background: #f0fdf4;
}

.uploadIcon {
    color: #94a3b8;
    transition: color 0.2s;
}

.uploadArea:hover .uploadIcon {
    color: var(--primary-blue);
}

.uploadAreaActive .uploadIcon {
    color: #10b981;
}

.uploadText {
    font-size: 0.82rem;
    color: #64748b;
    font-weight: 500;
}

.uploadHint {
    font-size: 0.7rem;
    color: #94a3b8;
}

.uploadedFile {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #166534;
}

/* Optional field */
.optionalField {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
}

.optionalLabel {
    font-size: 0.75rem;
    font-weight: 600;
    color: #374151;
}

.optionalInput {
    width: 100%;
    padding: 0.6rem 0.85rem;
    background: #f9fafb;
    border: 1.5px solid #e5e7eb;
    border-radius: 9px;
    color: #0f172a;
    font-size: 0.84rem;
    font-family: inherit;
    outline: none;
    transition: all 0.2s ease;
}

.optionalInput::placeholder {
    color: #b0b8c4;
}

.optionalInput:focus {
    background: #ffffff;
    border-color: var(--primary-blue);
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.08);
}

/* Sections &amp; Grids */
.section {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 0.5rem;
}

.sectionTitle {
    font-size: 0.9rem;
    font-weight: 700;
    color: #475569;
    letter-spacing: -0.01em;
}

.salaryGrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
}

.fieldGroup {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
}

.label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
}

/* Custom Add Field */
.customField {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
}

.addBtn {
    padding: 0.6rem 1rem;
    background: #f1f5f9;
    border: 1.5px solid #e2e8f0;
    border-radius: 9px;
    color: #475569;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.addBtn:hover:not(:disabled) {
    background: #e2e8f0;
    border-color: #cbd5e1;
}

.addBtn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.removeTag {
    background: none;
    border: none;
    color: currentColor;
    opacity: 0.7;
    margin-left: 0.2rem;
    font-size: 1.1rem;
    cursor: pointer;
    line-height: 1;
    display: flex;
    align-items: center;
}

.removeTag:hover {
    opacity: 1;
}

/* Toggles &amp; Progress */
.remoteToggle {
    margin: 0.5rem 0;
}

.toggleLabel {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
}

.toggleLabel input[type=&quot;checkbox&quot;] {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: var(--primary-blue);
}

.progressBar {
    width: 100%;
    height: 6px;
    background: #f1f5f9;
    border-radius: 10px;
    overflow: hidden;
    margin-top: 0.5rem;
}

.progressFill {
    height: 100%;
    background: var(--primary-blue);
    transition: width 0.3s ease;
}

/* Actions */
.actions {
    display: flex;
    gap: 0.55rem;
    align-items: center;
}

.backBtn {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.65rem 0.95rem;
    background: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 9px;
    color: #64748b;
    font-size: 0.82rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
}

.backBtn:hover {
    background: #f9fafb;
    border-color: #d1d5db;
    color: #374151;
}

.nextBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    flex: 1;
    padding: 0.7rem 1rem;
    background: var(--primary-blue);
    color: white;
    border: none;
    border-radius: 9px;
    font-size: 0.88rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(0, 123, 255, 0.3);
}

.nextBtn:hover:not(:disabled) {
    background: #0056d6;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0, 123, 255, 0.4);
}

.nextBtn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    box-shadow: none;
}

/* Skip link */
.skipLink {
    text-align: center;
    font-size: 0.72rem;
    color: #94a3b8;
}

.skipBtn {
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    font-family: inherit;
    transition: color 0.2s;
}

.skipBtn:hover {
    color: var(--primary-blue);
}

/* Selection counter */
.counter {
    font-size: 0.72rem;
    color: #94a3b8;
    text-align: right;
    font-weight: 500;
}

/* Responsive */
@media (max-width: 560px) {
    .card {
        max-width: 100%;
        margin: 0 0.75rem;
        padding: 1.5rem 1.25rem;
        border-radius: 16px;
    }

    .chipGrid {
        grid-template-columns: repeat(2, 1fr);
    }

    .title {
        font-size: 1.25rem;
    }
}

@media (max-height: 750px) {
    .card {
        gap: 1rem;
        padding: 1.5rem 1.75rem;
    }

    .chipGrid {
        gap: 0.4rem;
    }

    .chip {
        padding: 0.5rem 0.4rem;
        font-size: 0.74rem;
    }

    .uploadArea {
        padding: 1.25rem;
    }
}</content>
