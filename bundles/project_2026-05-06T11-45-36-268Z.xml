    align-items: flex-end;
    padding: 0.75rem 1rem;
}

.jobDetailCompany {
    color: white;
    font-size: 0.88rem;
    font-weight: 700;
}

.jobDetailContent {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
}

.jobDetailTitle {
    font-size: 1.1rem;
    font-weight: 800;
    color: #0f172a;
}

.jobDetailInfoRow {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
