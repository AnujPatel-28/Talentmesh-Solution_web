    <file path="app\(auth)\login\login.module.css" type="code">
      <content>/* ============================
   LOGIN PAGE — Centered Card
   Full-screen, no scroll, form in center
   ============================ */

.page {
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f3f2f1;
    position: relative;
    overflow: hidden;
    font-family: &apos;Inter&apos;, -apple-system, system-ui, sans-serif;
}

/* Background decorations */
.bgGlow1 {
    position: absolute;
    top: -15%;
    right: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 123, 255, 0.08) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
    animation: glowPulse 20s ease-in-out infinite alternate;
}

.bgGlow2 {
    position: absolute;
    bottom: -15%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 123, 255, 0.06) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
    animation: glowPulse 16s ease-in-out infinite alternate-reverse;
}

@keyframes glowPulse {
    0% {
        transform: scale(1);
        opacity: 0.7;
    }

    100% {
        transform: scale(1.15);
        opacity: 1;
    }
}

.gridOverlay {
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(0, 0, 0, 0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 0, 0, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
}

/* Card */
.card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 440px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 
        0 4px 6px -1px rgba(0, 0, 0, 0.01),
        0 20px 40px -8px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    animation: cardEnter 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes cardEnter {
    from {
        opacity: 0;
        transform: translateY(16px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* Logo */
.logoWrap {
    display: flex;
    justify-content: center;
    text-decoration: none;
}

.logoImg {
    filter: none;
    opacity: 1;
}

/* Persona Toggle */
.personaToggle {
    position: relative;
    display: flex;
    padding: 3px;
    background: #f1f5f9;
    border-radius: 10px;
}

.toggleSlider {
    position: absolute;
    top: 3px;
    left: 3px;
    width: calc(50% - 3px);
    height: calc(100% - 6px);
    background: #ffffff;
    border-radius: 8px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08), 0 1px 2px rgba(0, 0, 0, 0.04);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
}

.toggleSliderRight {
    transform: translateX(100%);
}

.toggleBtn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.55rem 0.75rem;
    background: transparent;
    border: none;
    border-radius: 8px;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    color: #94a3b8;
    cursor: pointer;
    transition: color 0.25s ease;
    position: relative;
    z-index: 1;
}

.toggleBtnActive {
    color: #0f172a;
}

.toggleBtn:hover:not(.toggleBtnActive) {
    color: #64748b;
}

/* Header */
.header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
}

.title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
}

.subtitle {
    font-size: 0.82rem;
    color: #94a3b8;
    font-weight: 400;
}

.errorMessage {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    background: #fef2f2;
    border: 1px solid #fee2e2;
    border-radius: 12px;
    color: #ef4444;
    font-size: 0.85rem;
    text-align: center;
}

.resendLink {
    color: #ef4444;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
}

/* Social Row */
.socialRow {
    display: flex;
    gap: 0.6rem;
}

.socialBtn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    background: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 9px;
    color: #374151;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
}

.socialBtn:hover {
    background: #f9fafb;
    border-color: #d1d5db;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
}

/* Divider */
.divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.dividerLine {
    flex: 1;
    height: 1px;
    background: #e5e7eb;
}

.dividerText {
    font-size: 0.72rem;
    color: #94a3b8;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

/* Form */
.form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.fieldGroup {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
}

.label {
    font-size: 0.78rem;
    font-weight: 600;
    color: #374151;
}

.labelRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.forgotLink {
    font-size: 0.75rem;
    color: var(--primary-blue);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
}

.forgotLink:hover {
    color: #0056d6;
}

.inputWrap {
    position: relative;
    display: flex;
    align-items: center;
}

.inputIcon {
    position: absolute;
    left: 0.8rem;
    color: #c0c7d0;
    pointer-events: none;
    z-index: 1;
    transition: color 0.2s ease;
}

.inputWrap:focus-within .inputIcon {
    color: var(--primary-blue);
}

.input {
    width: 100%;
    padding: 0.68rem 0.9rem 0.68rem 2.5rem;
    background: #f9fafb;
    border: 1.5px solid #e5e7eb;
    border-radius: 9px;
    color: #0f172a;
    font-size: 0.85rem;
    font-family: inherit;
    outline: none;
    transition: all 0.2s ease;
}

.input::placeholder {
    color: #b0b8c4;
}

.input:focus {
    background: #ffffff;
    border-color: var(--primary-blue);
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.08);
}

.input:hover:not(:focus) {
    border-color: #d1d5db;
}

.eyeBtn {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    color: #b0b8c4;
    cursor: pointer;
    padding: 2px;
    display: flex;
    align-items: center;
    transition: color 0.2s;
}

.eyeBtn:hover {
    color: #64748b;
}

/* Options Row */
.optionsRow {
    display: flex;
    align-items: center;
}

.checkboxLabel {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    user-select: none;
}

.checkbox {
    display: none;
}

.checkboxCustom {
    width: 16px;
    height: 16px;
    border: 1.5px solid #d1d5db;
    border-radius: 4px;
    background: #ffffff;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
}

.checkboxCustom svg {
    width: 9px;
    height: 9px;
    opacity: 0;
    transition: opacity 0.15s ease;
}

.checkbox:checked+.checkboxCustom {
    background: var(--primary-blue);
    border-color: var(--primary-blue);
}

.checkbox:checked+.checkboxCustom svg {
    opacity: 1;
}

.checkboxText {
    font-size: 0.78rem;
    color: #64748b;
    font-weight: 500;
}

/* Submit button */
.submitBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.72rem 1.5rem;
    background: var(--primary-blue);
    color: white;
    border: none;
    border-radius: 9px;
    font-size: 0.88rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(0, 123, 255, 0.3);
}

.submitBtn:hover:not(:disabled) {
    background: #0056d6;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0, 123, 255, 0.4);
}

.submitBtn:active:not(:disabled) {
    transform: translateY(0);
}

.submitBtn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.spinnerWrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

/* Footer */
.footer {
    text-align: center;
    font-size: 0.82rem;
    color: #94a3b8;
}

.footerLink {
    color: var(--primary-blue);
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s;
}

.footerLink:hover {
    color: #0056d6;
}

/* Terms — pinned to bottom */
.terms {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.68rem;
    color: #b0b8c4;
    text-align: center;
    white-space: nowrap;
    z-index: 1;
}

.termsLink {
    color: #94a3b8;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
}

.termsLink:hover {
    color: var(--primary-blue);
}

/* Both candidate and recruiter use the same brand blue theme */

/* ============================
   RESPONSIVE — fits all screens
   ============================ */
@media (max-width: 480px) {
    .card {
        max-width: 100%;
        margin: 0 1rem;
        padding: 1.75rem 1.5rem;
        border-radius: 16px;
    }

    .title {
        font-size: 1.35rem;
    }

    .socialRow {
        flex-direction: column;
        gap: 0.45rem;
    }
}

@media (max-height: 700px) {
    .card {
        gap: 1rem;
        padding: 1.5rem 2rem;
    }

    .form {
        gap: 0.75rem;
    }

    .input {
        padding-top: 0.6rem;
        padding-bottom: 0.6rem;
    }

    .toggleBtn {
        padding: 0.45rem 0.5rem;
    }

    .submitBtn {
        padding: 0.6rem 1rem;
    }
}</content>
