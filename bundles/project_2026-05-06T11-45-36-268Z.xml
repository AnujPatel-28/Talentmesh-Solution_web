    <file path="app\utility.module.css" type="code">
      <content>.utilityPage {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    padding: 10rem 2rem;
    overflow: hidden;
    position: relative;
}

.container {
    max-width: 1200px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 6rem;
    position: relative;
    z-index: 10;
}

.content {
    text-align: left;
    position: relative;
}

.subtitle {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--primary-blue);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 2rem;
    display: block;
}

.big404 {
    font-size: 15rem;
    font-weight: 900;
    line-height: 0.8;
    margin-bottom: 2rem;
    color: var(--deep-navy);
    letter-spacing: -0.08em;
    position: relative;
    background: linear-gradient(135deg, var(--deep-navy) 20%, #1e40af);
    -webkit-background-clip: text;
    background-clip: text;
}

.title {
    font-weight: 900;
    color: var(--deep-navy);
    line-height: 1.1;
    letter-spacing: -0.04em;
}

.description {
    font-size: 1.25rem;
    color: var(--medium-grey);
    margin: 3rem 0;
    line-height: 1.7;
    max-width: 500px;
}

.spotlight {
    position: absolute;
    top: 50%;
    left: 20%;
    transform: translate(-50%, -50%);
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 123, 255, 0.08) 0%, transparent 70%);
    z-index: -1;
    pointer-events: none;
    animation: pulseSpotlight 6s ease-in-out infinite;
}

@keyframes pulseSpotlight {

    0%,
    100% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 0.5;
    }

    50% {
        transform: translate(-50%, -50%) scale(1.2);
        opacity: 0.8;
    }
}

.buttonGroup {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
}

.primaryButton {
    background: var(--primary-blue);
    color: #ffffff;
    padding: 1.5rem 3.5rem;
    border-radius: 100px;
    font-weight: 900;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    transition: var(--transition-smooth);
    box-shadow: 0 10px 40px rgba(0, 123, 255, 0.15);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.9rem;
}

.primaryButton:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 20px 50px rgba(0, 123, 255, 0.25);
    background: #006ae0;
}

.secondaryButton {
    background: #ffffff;
    color: var(--deep-navy);
    padding: 1.5rem 3.5rem;
    border-radius: 100px;
    font-weight: 900;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    transition: var(--transition-smooth);
    border: 2px solid #e2e8f0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.9rem;
}

.secondaryButton:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    transform: translateY(-5px);
}

.visualSide {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
}

.illustration {
    width: 100%;
    max-width: 650px;
    height: auto;
    filter: drop-shadow(0 30px 60px rgba(0, 123, 255, 0.08));
    animation: float 8s ease-in-out infinite;
}

@keyframes float {

    0%,
    100% {
        transform: translateY(0) rotate(0deg);
    }

    50% {
        transform: translateY(-30px) rotate(1deg);
    }
}

.blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    z-index: 1;
    opacity: 0.4;
}

.blob1 {
    width: 700px;
    height: 700px;
    background: var(--light-ice-blue);
    top: -20%;
    right: -10%;
}

.blob2 {
    width: 600px;
    height: 600px;
    background: var(--alice-blue);
    bottom: -20%;
    left: -10%;
}

@media (max-width: 1024px) {
    .utilityPage {
        padding: 5rem 2rem;
        min-height: 100vh;
        overflow-y: auto;
    }

    .container {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 3rem;
    }

    .content {
        align-items: center;
        width: 100%;
        order: 2;
    }

    .visualSide {
        order: 1;
        width: 100%;
    }

    .illustration {
        max-width: 380px;
        margin: 0 auto;
    }

    .big404 {
        font-size: clamp(8rem, 25vw, 12rem);
        margin-bottom: 1rem;
    }

    .title {
        font-size: 3rem !important;
        margin-top: 0 !important;
    }

    .description {
        font-size: 1.125rem;
        margin: 2rem auto;
        max-width: 600px;
    }

    .buttonGroup {
        justify-content: center;
        width: 100%;
    }

    .spotlight {
        left: 50%;
        top: 30%;
    }
}

@media (max-width: 768px) {
    .utilityPage {
        padding: 4rem 1.5rem;
    }

    .container {
        gap: 2rem;
    }

    .big404 {
        font-size: clamp(6rem, 30vw, 8rem);
    }

    .title {
        font-size: 2.25rem !important;
    }

    .buttonGroup {
        flex-direction: column;
        max-width: 350px;
        margin: 0 auto;
    }

    .primaryButton,
    .secondaryButton {
        width: 100%;
        justify-content: center;
        padding: 1.1rem 2rem;
    }

    .illustration {
        max-width: 280px;
    }
}

@media (max-width: 480px) {
    .utilityPage {
        padding: 3rem 1rem;
    }

    .big404 {
        font-size: 5.5rem;
    }

    .title {
        font-size: 1.85rem !important;
    }

    .description {
        font-size: 1rem;
    }

    .illustration {
        max-width: 220px;
    }
}</content>
