    <file path="app\employers\sourcing\sourcing.module.css" type="code">
      <content>.page {
    padding-top: 68px;
    min-height: 100vh;
    background: var(--light-ice-blue, #F0F7FF);
}

/* ─── Hero ── */
.hero {
    background: linear-gradient(135deg, #0f172a 0%, #020617 100%);
    padding: 80px 0;
    position: relative;
    overflow: hidden;
}

.dotGrid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(144, 202, 249, 0.15) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
}

.heroInner {
    text-align: center;
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
}

.heroBadge {
    display: inline-block;
    background: rgba(33, 150, 243, 0.16);
    border: 1px solid rgba(33, 150, 243, 0.32);
    color: var(--cool-sky-2, #42A5F5);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 16px;
    border-radius: 999px;
    margin-bottom: 20px;
}

.heroTitle {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    color: white;
    margin: 0 0 16px;
    line-height: 1.15;
    letter-spacing: -0.02em;
}

.heroSub {
    font-size: 1.05rem;
    color: #BBDEFB;
    margin: 0 auto 36px;
    line-height: 1.65;
}

.heroCta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: white;
    color: var(--ocean-deep, #1565C0);
    border: none;
    padding: 14px 28px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
}

.heroCta:hover {
    background: var(--primary-blue, #007BFF);
    color: white;
    transform: translateY(-2px);
}

/* ─── Sections ── */
.sectionTitle {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--cobalt-blue);
    text-align: center;
    margin: 0 0 40px;
}

.howSection {
    background: white;
    padding: 72px 0;
}

.stepsRow {
    display: flex;
    align-items: stretch;
    gap: 0;
}

.stepCard {
    flex: 1;
    background: white;
    border-radius: 14px;
    padding: 28px 20px;
    border: 1px solid var(--sky-blue);
    position: relative;
}

.stepArrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sky-blue);
    flex-shrink: 0;
    padding: 0 8px;
}

.stepNum {
    font-size: 3rem;
    font-weight: 800;
    color: var(--primary-blue);
    line-height: 1;
    margin-bottom: 12px;
}

.stepTitle {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--cobalt-blue);
    margin: 0 0 8px;
}

.stepDesc {
    font-size: 0.83rem;
    color: var(--medium-grey);
    line-height: 1.55;
    margin: 0;
}

/* ─── Detail Section ── */
.detailSection {
    background: var(--light-ice-blue);
    padding: 72px 0;
}

.detailGrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
}

.inclusionList {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.inclusionItem {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--medium-grey);
}

.checkIco {
    color: var(--primary-blue);
    flex-shrink: 0;
    margin-top: 1px;
}

.industryGrid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.industryChip {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--alice-blue);
    color: var(--ocean-deep);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 0.85rem;
    font-weight: 500;
    border: 1px solid rgba(144, 202, 249, 0.4);
    cursor: default;
    transition: all 0.2s ease;
}

.industryChip:hover {
    background: var(--dodger-blue);
    color: white;
}

.industryIcon {
    font-size: 1rem;
}

/* ─── Form Section ── */
.formSection {
    background: white;
    padding: 72px 0;
}

.formSubtitle {
    text-align: center;
    color: var(--medium-grey);
    font-size: 0.95rem;
    margin: -28px 0 40px;
}

.formCard {
    max-width: 680px;
    margin: 0 auto;
    background: white;
    border-radius: 20px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.10);
    overflow: hidden;
}

.form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 40px;
}

.fieldRow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.lbl {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--cobalt-blue);
}

.opt {
    font-style: italic;
    font-weight: 400;
    color: var(--medium-grey);
    font-size: 0.8rem;
}

.input,
.textarea {
    border: 1px solid var(--sky-blue);
    border-radius: 8px;
    padding: 11px 14px;
    font-size: 0.9rem;
    font-family: inherit;
    color: var(--deep-navy, #0d2137);
    background: white;
    outline: none;
    appearance: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.input:focus,
.textarea:focus {
    border-color: var(--primary-blue);
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.12);
}

.input::placeholder,
.textarea::placeholder {
    color: rgba(71, 85, 105, 0.5);
}

.dashed {
    border-style: dashed;
    border-color: #BBDEFB;
}

.textarea {
    resize: vertical;
}

.submitBtn {
    width: 100%;
    height: 52px;
    background: linear-gradient(135deg, var(--primary-blue), var(--dodger-blue));
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
    margin-top: 4px;
}

.submitBtn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 123, 255, 0.4);
}

/* Success state */
.successState {
    text-align: center;
    padding: 52px 32px;
}

.successCircle {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--dodger-blue), var(--primary-blue));
    color: white;
    font-size: 1.5rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    animation: popIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes popIn {
    from {
        transform: scale(0);
    }

    to {
        transform: scale(1);
    }
}

.successTitle {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--cobalt-blue);
    margin: 0 0 10px;
}

.successDesc {
    font-size: 0.95rem;
    color: var(--medium-grey);
    margin: 0 0 20px;
}

.successBadge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--alice-blue);
    color: var(--ocean-deep);
    font-weight: 600;
    font-size: 0.88rem;
    padding: 8px 20px;
    border-radius: 999px;
    border: 1px solid var(--sky-blue);
}

/* ─── Responsive ── */
@media (max-width: 1024px) {
    .stepsRow {
        flex-wrap: wrap;
    }

    .stepCard {
        min-width: calc(50% - 24px);
    }

    .stepArrow {
        display: none;
    }

    .detailGrid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 640px) {
    .form {
        padding: 24px 20px;
    }

    .fieldRow {
        grid-template-columns: 1fr;
    }

    .stepCard {
        min-width: 100%;
    }
}</content>
