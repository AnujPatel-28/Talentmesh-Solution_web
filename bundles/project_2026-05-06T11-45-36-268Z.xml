const JOB_TYPES = [&apos;Full-Time&apos;, &apos;Part-Time&apos;, &apos;Remote&apos;, &apos;Hybrid&apos;, &apos;Contract&apos;];
const INDUSTRIES = [&apos;Technology&apos;, &apos;Product&apos;, &apos;Design&apos;, &apos;Finance&apos;, &apos;Sales &amp; Marketing&apos;, &apos;HR &amp; People&apos;, &apos;Operations&apos;, &apos;Customer Success&apos;];
